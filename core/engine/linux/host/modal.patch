+RetainedScene modalScene() {
+    RetainedScene scene;
+    scene.createSurfaceRoot(kSurfaceTag, {300, 200});
+    addChild(scene, kSurfaceTag, makePaintedView(2, makeRect(0, 0, 300, 200), blue()));
+    auto parentProps = propsWithBackground(red());
+    parentProps->opacity = 0.1;
+    parentProps->yogaStyle.setOverflow(facebook::yoga::Overflow::Hidden);
+    auto parent = makeStyledView(3, makeRect(100, 100, 5, 5), parentProps);
+    addChild(scene, kSurfaceTag, parent);
+    addChild(scene, 3, modalView(4, makeRect(30, 40, 300, 200)));
