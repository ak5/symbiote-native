+TEST(ModalSceneTest, PresentationEscapesParentGeometryAndFadesAsOneCompositedLayer) {
+    auto scene = modalScene();
+    scene.setModalPresentations({{.tag = 4, .size = {300, 200}, .opacity = 0.5, .translateY = 50}}, 4);
+    const auto snapshot = scene.snapshot();
+    ASSERT_FALSE(snapshot.empty());
+    const auto& field = snapshot.back();
+    EXPECT_EQ(field.tag, 5);
+    EXPECT_EQ(field.frame, makeRect(10, 20, 40, 30));
+    EXPECT_EQ(field.matrix.translateY, 50);
+    EXPECT_EQ(field.backgroundColorArgb, kBlueArgb);
+    EXPECT_EQ(field.opensLayers, std::vector<float>{0.5});
+    EXPECT_EQ(field.closesLayers, 1);
+    ASSERT_EQ(field.clips.size(), 1);
+    EXPECT_EQ(field.clips.front().frame, makeRect(0, 0, 300, 200));
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {15, 75}).tag, 5);
+    EXPECT_NE(scene.findNodeAtPoint(kSurfaceTag, {15, 25}).tag, 2);
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {15, 205}).tag, 0);
+    const auto accessible = scene.accessibilitySnapshot();
+    EXPECT_EQ(accessible.nodes.size(), 2);
+    EXPECT_EQ(accessible.nodes.at(4).parentTag, 0);
+    EXPECT_EQ(accessible.nodes.at(4).accessibility.accessibilityRole, "dialog");
+    EXPECT_EQ(accessible.geometry.at(5).bounds, makeRect(10, 70, 40, 30));
+}
+
+TEST(ModalSceneTest, NestedModalsPaintOnceAndOnlyTheTopModalReceivesInputOrAccessibility) {
+    auto scene = modalScene();
+    addChild(scene, 4, modalView(6, makeRect(60, 60, 300, 200)));
+    addChild(scene, 6, makePaintedView(7, makeRect(10, 20, 40, 30), red()));
+    scene.setModalPresentations({{.tag = 4, .size = {300, 200}}, {.tag = 6, .size = {300, 200}}}, 6);
+    const auto snapshot = scene.snapshot();
+    EXPECT_EQ(std::ranges::count(snapshot, 5, &ScenePrimitive::tag), 1);
+    EXPECT_EQ(std::ranges::count(snapshot, 7, &ScenePrimitive::tag), 1);
+    EXPECT_EQ(snapshot.back().tag, 7);
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {15, 25}).tag, 7);
+    const auto accessible = scene.accessibilitySnapshot();
+    EXPECT_TRUE(accessible.nodes.contains(6));
+    EXPECT_TRUE(accessible.nodes.contains(7));
+    EXPECT_FALSE(accessible.nodes.contains(4));
+    EXPECT_FALSE(accessible.nodes.contains(5));
+    scene.setModalPresentations({{.tag = 4, .size = {300, 200}}}, 6);
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {15, 25}).tag, 0);
+    EXPECT_TRUE(scene.accessibilitySnapshot().nodes.empty());
+}
+
+TEST(ModalSceneTest, UpdatingAModalChildDamagesItsPresentedPositionAndDismissalErasesIt) {
+    auto scene = modalScene();
+    scene.setModalPresentations({{.tag = 4, .size = {300, 200}, .translateY = 50}}, 4);
+    scene.takeDamage();
+    scene.updateNode(makePaintedView(5, makeRect(10, 20, 40, 30), red()));
+    const auto damage = scene.takeDamage();
+    ASSERT_FALSE(damage.empty());
+    for (const auto& rect : damage) {
+        EXPECT_EQ(rect, makeRect(10, 70, 40, 30));
+    }
+    EXPECT_FALSE(scene.setModalPresentations({{.tag = 4, .size = {300, 200}, .translateY = 50}}, 4));
+    EXPECT_TRUE(scene.takeDamage().empty());
+    scene.setModalPresentations({}, 0);
+    const auto dismissed = scene.takeDamage();
+    ASSERT_EQ(dismissed.size(), 1);
+    EXPECT_EQ(dismissed.front(), makeRect(10, 70, 40, 30));
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {15, 75}).tag, 2);
+}
