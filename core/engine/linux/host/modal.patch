+TEST_F(ModalControllerTest, ScrollInputUsesThePresentedModalAndCannotReachTheBackground) {
+    facebook::react::ScrollViewComponentDescriptor scrollDescriptor{facebook::react::ComponentDescriptorParameters{
+        .eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    const auto content = makeConfiguredShadowNode(
+        viewDescriptor_, 26, kSurfaceId, contextContainer_, folly::dynamic::object("width", 100)("height", 600),
+        std::make_shared<const std::vector<std::shared_ptr<const facebook::react::ShadowNode>>>());
+    const auto scroll = makeConfiguredShadowNode(
+        scrollDescriptor, 24, kSurfaceId, contextContainer_, folly::dynamic::object("width", 100)("height", 100),
+        std::make_shared<const std::vector<std::shared_ptr<const facebook::react::ShadowNode>>>(
+            std::vector<std::shared_ptr<const facebook::react::ShadowNode>>{content}));
+    commit({children(modal(folly::dynamic::object("visible", true)), {scroll})});
+    facebook::react::ShadowViewMutationList mutations;
+    std::function<void(const facebook::react::ShadowNode&)> mount = [&](const auto& parent) {
+        int index = 0;
+        for (const auto& child : parent.getChildren()) {
+            const facebook::react::ShadowView view{*child};
+            mutations.push_back(facebook::react::ShadowViewMutation::CreateMutation(view));
+            mutations.push_back(facebook::react::ShadowViewMutation::InsertMutation(parent.getTag(), view, index++));
+            mount(*child);
+        }
+    };
+    uiManager_->getShadowTreeRegistry().visit(
+        kSurfaceId, [&](const auto& tree) { mount(*tree.getCurrentRevision().rootShadowNode); });
+    mountingManager_->startSurface(kSurfaceId, {400, 300});
+    mountingManager_->executeMount(kSurfaceId,
+                                   facebook::react::MountingTransaction{kSurfaceId, 1, std::move(mutations),
+                                                                        facebook::react::TransactionTelemetry{}});
+    InputDispatcher keyboard(uiManager_, mountingManager_, kSurfaceId);
+    const InputEvent pageDown{.kind = InputEventKind::KeyPress, .key = "PageDown"};
+    keyboard.dispatch({pageDown});
+    EXPECT_TRUE(mountingManager_->takeCommands().empty());
+    keyboard.setModalRoot(2);
+    keyboard.dispatch({pageDown});
+    const auto commands = mountingManager_->takeCommands();
+    ASSERT_EQ(commands.size(), 1);
+    EXPECT_EQ(commands.front().tag, 24);
+    mountingManager_->setModalPresentations({{.tag = 2, .size = {400, 300}, .translateY = 100}}, 2);
+    const InputEvent wheel{
+        .kind = InputEventKind::PointerScrollContinuous, .surfacePoint = {10, 110}, .scrollAmount = 50};
+    ScrollController controller(uiManager_, kSurfaceId);
+    controller.setModalRoot(2, mountingManager_);
+    controller.dispatch({wheel});
+    controller.advance(16);
+    EXPECT_TRUE(controller.hasDispatchedScrollEvent());
+    ScrollController blocked(uiManager_, kSurfaceId);
+    blocked.setModalRoot(2, mountingManager_);
+    auto outside = wheel;
+    outside.surfacePoint = {10, 10};
+    blocked.dispatch({outside});
+    blocked.advance(16);
+    EXPECT_FALSE(blocked.hasDispatchedScrollEvent());
+}
