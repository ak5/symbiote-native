+                {.tag = tag,
+                 .size = displaySize,
+                 .opacity = props.animationType == facebook::react::ModalHostViewAnimationType::Fade
+                                ? static_cast<facebook::react::Float>(entry.progress)
+                                : 1,
+                 .translateY = props.animationType == facebook::react::ModalHostViewAnimationType::Slide
+                                   ? static_cast<facebook::react::Float>((1 - entry.progress) * displaySize.height)
+                                   : 0});
