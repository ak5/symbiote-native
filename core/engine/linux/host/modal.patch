+#include <gtest/gtest.h>
+
+namespace react_native_linux {
+namespace {
+
+constexpr char kSetup[] = R"JAVASCRIPT(
+if (!globalThis.__nativeComponentRegistry__hasComponent('ModalHostView')) {
+  throw new Error('ModalHostView has no native registration');
+}
+globalThis.fabric = globalThis.nativeFabricUIManager;
+globalThis.events = [];
+globalThis.handles = [];
+fabric.registerEventHandler((target, type) => events.push(type));
+globalThis.node = (tag, name, props) => {
+  const handle = {stateNode: {node: null}};
+  handles.push(handle);
+  handle.stateNode.node = fabric.createNode(tag, name, 1, props, handle);
+  return handle.stateNode.node;
+};
+globalThis.content = node(2, 'View', {
+  width: '100%', height: '100%', backgroundColor: 0xffffffff, collapsable: false,
+});
+globalThis.subject = node(4, 'ModalHostView', {
+  visible: true, animationType: 'none',
+  onShow: true, onDismiss: true, onRequestClose: true, onOrientationChange: true,
+});
+fabric.appendChild(subject, content);
+globalThis.parent = node(6, 'View', {
+  width: 20, height: 20, left: 100, top: 100,
+  overflow: 'hidden', opacity: 0.1, collapsable: false,
+});
+globalThis.commit = () => {
+  parent = fabric.cloneNodeWithNewChildren(parent);
+  fabric.appendChild(parent, subject);
+  const children = fabric.createChildSet();
+  fabric.appendChildToSet(children, parent);
+  fabric.completeRoot(1, children);
+};
+commit();
+)JAVASCRIPT";
+
+void settleInitialSize(FantomTester& tester) {
+    tester.advanceModalFrame(0);
+    tester.advanceModalFrame(0);
+    ASSERT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(ModalHostTest, RegisteredModalSizesItsStockStateAndEscapesTheParentClip) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kSetup);
+    EXPECT_TRUE(tester.snapshotScene().empty());
+    settleInitialSize(tester);
+    const auto scene = tester.snapshotScene();
+    ASSERT_EQ(scene.size(), 1);
+    EXPECT_EQ(scene.front().tag, 2);
+    EXPECT_EQ(scene.front().frame, (facebook::react::Rect{{0, 0}, {400, 300}}));
+    EXPECT_EQ(scene.front().matrix.translateX, 0);
+    EXPECT_EQ(scene.front().matrix.translateY, 0);
+    EXPECT_EQ(scene.front().backgroundColorArgb >> 24, 255);
+    tester.runTask(R"JAVASCRIPT(
+if (events.filter(type => type === 'topShow').length !== 1) throw new Error('Expected one native show');
+if (events.filter(type => type === 'topOrientationChange').length !== 1) throw new Error('Expected native orientation');
+)JAVASCRIPT");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(ModalHostTest, EscapeRequestsAControlledCloseAndNativeDismissCompletesIt) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kSetup);
+    settleInitialSize(tester);
+    tester.advanceModalFrame(0, {InputEvent{.kind = InputEventKind::KeyPress, .key = "Escape"}});
+    EXPECT_FALSE(tester.snapshotScene().empty());
+    tester.runTask(R"JAVASCRIPT(
+if (events.filter(type => type === 'topRequestClose').length !== 1) throw new Error('Escape did not request close');
+if (events.includes('topDismiss')) throw new Error('A request cannot dismiss controlled content');
+subject = fabric.cloneNodeWithNewProps(subject, {visible: false});
+commit();
+)JAVASCRIPT");
+    tester.advanceModalFrame(0);
+    EXPECT_TRUE(tester.snapshotScene().empty());
+    tester.runTask(R"JAVASCRIPT(
+if (events.filter(type => type === 'topDismiss').length !== 1) throw new Error('Missing native dismissal');
+)JAVASCRIPT");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(ModalHostTest, FadeReachesNativeCompletionBeforeTheDismissEvent) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kSetup);
+    tester.runTask("subject = fabric.cloneNodeWithNewProps(subject, {animationType: 'fade'}); commit();");
+    settleInitialSize(tester);
+    tester.advanceModalFrame(125);
+    const auto halfway = tester.snapshotScene();
+    ASSERT_EQ(halfway.size(), 1);
+    EXPECT_EQ(halfway.front().opensLayers, std::vector<float>{0.5});
+    tester.runTask("if (events.includes('topShow')) throw new Error('Fade showed too early');");
+    tester.advanceModalFrame(125);
+    tester.runTask(R"JAVASCRIPT(
+if (events.filter(type => type === 'topShow').length !== 1) throw new Error('Fade never showed');
+subject = fabric.cloneNodeWithNewProps(subject, {visible: false});
+commit();
+)JAVASCRIPT");
+    tester.advanceModalFrame(125);
+    EXPECT_FALSE(tester.snapshotScene().empty());
+    tester.runTask("if (events.includes('topDismiss')) throw new Error('Fade dismissed too early');");
+    tester.advanceModalFrame(125);
+    EXPECT_TRUE(tester.snapshotScene().empty());
+    tester.runTask(
+        "if (events.filter(type => type === 'topDismiss').length !== 1) throw new Error('Fade never dismissed');");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
