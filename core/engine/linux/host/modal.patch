+                                                facebook::react::RawProps{folly::dynamic::object("visible", value)})});
+    }
+
+    std::shared_ptr<const facebook::react::ShadowNode>
+    children(const std::shared_ptr<const facebook::react::ShadowNode>& node,
+             std::vector<std::shared_ptr<const facebook::react::ShadowNode>> descendants) {
+        return descriptor_.cloneShadowNode(
+            *node,
+            facebook::react::ShadowNodeFragment{
+                .children = std::make_shared<const std::vector<std::shared_ptr<const facebook::react::ShadowNode>>>(
+                    std::move(descendants))});
+    }
+
+    void commit(std::vector<std::shared_ptr<const facebook::react::ShadowNode>> children,
+                facebook::react::Size size = {400, 300}) {
+        shadowTree_->commit(
+            [&](const facebook::react::RootShadowNode& root) {
+                const facebook::react::PropsParserContext context{kSurfaceId, *contextContainer_};
+                const auto resized =
+                    root.clone(context, exactSurfaceConstraints(size), facebook::react::LayoutContext{});
+                return cloneRootWithChildren(
+                    *resized,
+                    std::make_shared<const std::vector<std::shared_ptr<const facebook::react::ShadowNode>>>(children));
+            },
+            facebook::react::ShadowTreeCommitOptions{.enableStateReconciliation = false, .mountSynchronously = true});
+    }
+
+    size_t events(const std::string& name) const { return std::ranges::count(*recordedEventTypes_, name); }
+
+    facebook::react::ModalHostViewComponentDescriptor descriptor_{facebook::react::ComponentDescriptorParameters{
+        .eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    facebook::react::ViewComponentDescriptor viewDescriptor_{facebook::react::ComponentDescriptorParameters{
+        .eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+};
