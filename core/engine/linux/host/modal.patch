+void ModalController::collect(const std::shared_ptr<const facebook::react::ShadowNode>& node, bool parentVisible,
+                              std::vector<facebook::react::Tag>& order) {
+    const auto* layoutable = dynamic_cast<const facebook::react::LayoutableShadowNode*>(node.get());
+    bool visible = parentVisible &&
+                   (!layoutable || layoutable->getLayoutMetrics().displayType != facebook::react::DisplayType::None);
+    if (const auto modal = std::dynamic_pointer_cast<const facebook::react::ModalHostViewShadowNode>(node)) {
+        visible = visible && modal->getConcreteProps().visible;
+        const auto tag = modal->getTag();
+        if (visible || entries_.contains(tag)) {
+            auto& entry = entries_[tag];
+            if (entry.node && entry.node->getEventEmitter() != modal->getEventEmitter()) {
+                entry = {};
+            }
+            entry.node = modal;
+            entry.requestedVisible = visible;
+            entry.needsDismiss = entry.needsDismiss || visible;
+            order.push_back(tag);
+        }
+    }
+    for (const auto& child : node->getChildren()) {
+        collect(child, visible, order);
+    }
