+TEST_F(TextInputControllerTest, AcknowledgingAnUnchangedPropDoesNotResetNativeEdits) {
+    commitTextInput(folly::dynamic::object());
+    type("Q");
+    controller_->synchronize();
+    commitFieldProps(folly::dynamic::object("mostRecentEventCount", 1));
+    controller_->synchronize();
+    EXPECT_EQ(copiedFieldText(), "Q");
 }
 
