+    }
+    const bool changed = next != presentations_ || active != activeTag_;
+    presentations_ = std::move(next);
+    activeTag_ = active;
+    return changed;
+}
+
+bool ModalController::requestClose() {
+    const auto found = entries_.find(activeTag_);
+    if (found == entries_.end()) {
+        return false;
+    }
+    found->second.node->getConcreteEventEmitter().onRequestClose({});
