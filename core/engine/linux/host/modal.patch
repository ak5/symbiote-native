+    const auto accessible = scene.accessibilitySnapshot();
+    EXPECT_TRUE(accessible.nodes.contains(2));
+    EXPECT_FALSE(accessible.nodes.contains(4));
+    EXPECT_FALSE(accessible.nodes.contains(5));
