+TEST_F(TextInputControllerTest, SecureFieldsCannotCopyOrCutTheirContents) {
+    commitTextInput(folly::dynamic::object("secureTextEntry", true));
+    type("password");
+    controller_->synchronize();
+    const InputModifiers control{.control = true};
+    controller_->handleKey(key("a", control));
+    controller_->synchronize();
+    recordedEventTypes_->clear();
+    react_native_linux::setClipboardText("keep clipboard");
+
+    for (const auto* shortcut : {"c", "x"}) {
+        EXPECT_EQ(controller_->handleKey(key(shortcut, control)), TextInputKeyResult::Consumed);
+        controller_->synchronize();
+        EXPECT_EQ(react_native_linux::clipboardText(), "keep clipboard");
+        EXPECT_EQ(countRecorded(kChangeEvent), 0U);
+        EXPECT_EQ(countRecorded(kSelectionChangeEvent), 0U);
+    }
+}
+
+TEST_F(TextInputControllerTest, CopyAndCutWithoutASelectionPreserveBothTextAndClipboard) {
+    commitTextInput(folly::dynamic::object());
+    type("keep field");
+    controller_->synchronize();
+    recordedEventTypes_->clear();
+    react_native_linux::setClipboardText("keep clipboard");
+    const InputModifiers control{.control = true};
+
+    for (const auto* shortcut : {"c", "x"}) {
+        EXPECT_EQ(controller_->handleKey(key(shortcut, control)), TextInputKeyResult::Consumed);
+        controller_->synchronize();
+        EXPECT_EQ(react_native_linux::clipboardText(), "keep clipboard");
+        EXPECT_EQ(countRecorded(kChangeEvent), 0U);
+    }
+    controller_->handleKey(key("a", control));
+    controller_->handleKey(key("c", control));
+    EXPECT_EQ(react_native_linux::clipboardText(), "keep field");
+}
+
+TEST_F(TextInputControllerTest, EmptyClipboardPastePreservesTheSelectedText) {
+    commitTextInput(folly::dynamic::object());
+    type("keep selection");
+    const InputModifiers control{.control = true};
+    controller_->handleKey(key("a", control));
+    controller_->synchronize();
+    recordedEventTypes_->clear();
+    react_native_linux::setClipboardText("");
+
+    EXPECT_EQ(controller_->handleKey(key("v", control)), TextInputKeyResult::Consumed);
+    controller_->synchronize();
+    EXPECT_EQ(countRecorded(kChangeEvent), 0U);
+    EXPECT_EQ(countRecorded(kSelectionChangeEvent), 0U);
+    controller_->handleKey(key("c", control));
+    EXPECT_EQ(react_native_linux::clipboardText(), "keep selection");
+}
+
+TEST_F(TextInputControllerTest, ReadOnlyCutCopiesTheSelectionWithoutDeletingIt) {
+    commitTextInput(folly::dynamic::object("text", "read only")("readOnly", true));
+    const InputModifiers control{.control = true};
+    controller_->handleKey(key("a", control));
+    controller_->synchronize();
+    recordedEventTypes_->clear();
+    react_native_linux::setClipboardText("old clipboard");
+
+    EXPECT_EQ(controller_->handleKey(key("x", control)), TextInputKeyResult::Consumed);
+    controller_->synchronize();
+    EXPECT_EQ(react_native_linux::clipboardText(), "read only");
+    EXPECT_EQ(countRecorded(kChangeEvent), 0U);
+}
