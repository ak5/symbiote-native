diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -1907,16 +1907,9 @@
   asan_c_args = ['-DBUILT_WITH_ASAN=0']
 endif
 
-# ThreadSanitizer can't deal with futexes, and reports races for cases we don't care about
-# so add a define to work silence these issues.
+# Use synchronization visible to ThreadSanitizer and retain all diagnostics.
 if get_option('b_sanitize').contains('thread')
   pre_args += '-DTHREAD_SANITIZER=1'
-  tsan_blacklist = '-fsanitize-blacklist=@0@'.format(join_paths(meson.project_source_root(), 'build-support', 'tsan-blacklist.txt'))
-  if cc.has_argument(tsan_blacklist)
-    pre_args += tsan_blacklist
-  else
-    warning('Compiler does not support "-fsanitize-blacklist", expected race conditions will not be surpressed')
-  endif
 else
   pre_args += '-DTHREAD_SANITIZER=0'
 endif
diff --git a/src/vulkan/runtime/vk_sync.c b/src/vulkan/runtime/vk_sync.c
--- a/src/vulkan/runtime/vk_sync.c
+++ b/src/vulkan/runtime/vk_sync.c
@@ -201,13 +201,16 @@
 get_max_abs_timeout_ns(void)
 {
    static int max_timeout_ms = -1;
-   if (max_timeout_ms < 0)
-      max_timeout_ms = debug_get_num_option("MESA_VK_MAX_TIMEOUT", 0);
-
-   if (max_timeout_ms == 0)
+   int timeout_ms = p_atomic_read(&max_timeout_ms);
+   if (timeout_ms < 0) {
+      timeout_ms = debug_get_num_option("MESA_VK_MAX_TIMEOUT", 0);
+      p_atomic_set(&max_timeout_ms, timeout_ms);
+   }
+
+   if (timeout_ms == 0)
       return UINT64_MAX;
    else
-      return os_time_get_absolute_timeout(max_timeout_ms * 1000000ull);
+      return os_time_get_absolute_timeout(timeout_ms * 1000000ull);
 }
 
 static VkResult
