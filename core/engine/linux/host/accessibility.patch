+    commit(parent->clone(ShadowNodeFragment{.props = props}));
+    react_native_linux::InputDispatcher dispatcher(uiManager_, mountingManager_, kSurfaceId);
+    dispatcher.dispatchAccessibilityActions({pending});
+    EXPECT_FALSE(clicked());
+    EXPECT_EQ(mountingManager_->accessibilitySnapshot().focusedTag, 0);
+}
