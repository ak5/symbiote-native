+struct AccessibilityBridge::State {
+    struct Registry {
+        std::mutex mutex;
+        uintptr_t nextToken{1};
+        std::unordered_map<uintptr_t, std::weak_ptr<State>> entries;
+    };
+
+    static Registry& registry() {
+        // AccessKit queues removal asynchronously; late callbacks must outlive the C++ session safely.
+        static folly::Indestructible<Registry> registrations;
+        return *registrations;
+    }
+
+    static std::shared_ptr<State> lookup(void* data) {
+        auto& registrations = registry();
+        const std::scoped_lock lock(registrations.mutex);
+        const auto found = registrations.entries.find(reinterpret_cast<uintptr_t>(data));
+        return found == registrations.entries.end() ? nullptr : found->second.lock();
+    }
+
+    std::atomic<bool> active{false};
+    std::atomic<std::shared_ptr<const Publication>> publication{std::make_shared<const Publication>()};
+    std::mutex mutex;
+    std::vector<NativeAccessibilityAction> actions;
+    size_t queuedTextBytes{0};
+    WakeDescriptor wake;
+    uintptr_t token{0};
+    std::unique_ptr<accesskit_unix_adapter, decltype(&accesskit_unix_adapter_free)> adapter{
+        nullptr, accesskit_unix_adapter_free};
+
+    void connect(const std::shared_ptr<State>& self) {
+        auto& registrations = registry();
+        {
+            const std::scoped_lock lock(registrations.mutex);
+            if (registrations.nextToken == std::numeric_limits<uintptr_t>::max()) {
+                throw std::overflow_error("Accessibility callback tokens exhausted");
+            }
+            token = registrations.nextToken++;
+            registrations.entries.emplace(token, self);
+        }
+        void* data = reinterpret_cast<void*>(token);
+        adapter.reset(accesskit_unix_adapter_new(
+            [](void* data) -> accesskit_tree_update* {
+                if (const auto state = lookup(data)) {
+                    state->active = true;
+                    state->wake.signal();
+                }
+                // The frame thread sends the real full tree through AccessKit's asynchronous activation path.
+                return nullptr;
+            },
+            data,
+            [](accesskit_action_request* raw, void* data) {
+                std::unique_ptr<accesskit_action_request, decltype(&accesskit_action_request_free)> request(
+                    raw, accesskit_action_request_free);
+                const auto state = lookup(data);
+                if (!state || !std::ranges::equal(request->target_tree.bytes, ACCESSKIT_TREE_ID_ROOT.bytes)) {
+                    return;
+                }
+                const auto current = state->publication.load();
+                for (const auto& [tag, node] : current->snapshot.nodes) {
+                    if (nativeId(node) != request->target_node || disabled(node)) {
+                        continue;
+                    }
+                    const auto role =
+                        effectiveAccessibilityRole(node.accessibility.accessibilityRole, node.accessibility.role);
+                    NativeAccessibilityAction action{.kind = NativeAccessibilityAction::Kind::Focus,
+                                                     .tag = tag,
+                                                     .emitter = node.accessibilityEmitter,
+                                                     .role = role};
+                    if (request->action == ACCESSKIT_ACTION_FOCUS || request->action == ACCESSKIT_ACTION_CLICK) {
+                        if (!focusable(node)) {
+                            return;
+                        }
+                        if (request->action == ACCESSKIT_ACTION_CLICK) {
+                            if (!clickable(roleOf(node, role))) {
+                                return;
+                            }
+                            action.kind = NativeAccessibilityAction::Kind::Activate;
+                        }
+                    } else if (request->action == ACCESSKIT_ACTION_SET_VALUE ||
+                               request->action == ACCESSKIT_ACTION_SET_TEXT_SELECTION) {
+                        const auto geometry = current->snapshot.geometry.find(tag);
+                        if (!node.editor || geometry == current->snapshot.geometry.end() || !geometry->second.editor ||
+                            !request->data.has_value) {
+                            return;
+                        }
+                        action.contentRevision = geometry->second.editor->contentRevision;
+                        const auto& data = request->data.value;
+                        if (request->action == ACCESSKIT_ACTION_SET_VALUE) {
+                            if (!node.editor->isEditable || data.tag != ACCESSKIT_ACTION_DATA_VALUE || !data.value) {
+                                return;
+                            }
+                            const auto bytes = strnlen(data.value, kMaximumPendingTextBytes + 1);
+                            if (bytes > kMaximumPendingTextBytes) {
+                                std::cerr << "[a11y] editable text exceeds the pending-transfer limit\n";
+                                return;
+                            }
+                            action.kind = NativeAccessibilityAction::Kind::SetValue;
+                            action.text.assign(data.value, bytes);
+                        } else {
+                            if (data.tag != ACCESSKIT_ACTION_DATA_SET_TEXT_SELECTION) {
+                                return;
+                            }
+                            const auto& selection = data.set_text_selection;
+                            const auto textIdentity = nativeId(node) + 1;
+                            if (selection.anchor.node != textIdentity || selection.focus.node != textIdentity) {
+                                return;
+                            }
+                            const auto segments = segmentText(accessibilityText(node));
+                            if (selection.anchor.character_index >= segments.graphemeStarts.size() ||
+                                selection.focus.character_index >= segments.graphemeStarts.size()) {
+                                return;
+                            }
+                            action.kind = NativeAccessibilityAction::Kind::SetSelection;
+                            action.selectionAnchor = selection.anchor.character_index;
+                            action.selectionFocus = selection.focus.character_index;
+                        }
+                    } else {
+                        return;
+                    }
+                    const std::scoped_lock lock(state->mutex);
+                    if (!state->active) {
+                        return;
+                    }
+                    if (state->actions.size() == kMaximumPendingActions ||
+                        action.text.size() > kMaximumPendingTextBytes - state->queuedTextBytes) {
+                        std::cerr << "[a11y] pending action capacity exceeded\n";
+                        return;
+                    }
+                    state->queuedTextBytes += action.text.size();
+                    state->actions.push_back(std::move(action));
+                    state->wake.signal();
+                    return;
+                }
+            },
+            data,
+            [](void* data) {
+                if (const auto state = lookup(data)) {
+                    state->active = false;
+                    const std::scoped_lock lock(state->mutex);
+                    state->actions.clear();
+                    state->queuedTextBytes = 0;
+                }
+            },
+            data));
+    }
+
+    void close() {
+        auto& registrations = registry();
+        {
+            const std::scoped_lock lock(registrations.mutex);
+            registrations.entries.erase(token);
+        }
+        adapter.reset();
+    }
+
+    accesskit_tree_update* build() {
+        const auto current = publication.load();
+        return TreeBuilder(*current).build();
+    }
+};
+
+AccessibilityBridge::AccessibilityBridge() : state_(std::make_shared<State>()) { state_->connect(state_); }
+
+AccessibilityBridge::~AccessibilityBridge() { state_->close(); }
+
+bool AccessibilityBridge::needsSnapshot() const noexcept { return state_->active; }
+
+int AccessibilityBridge::wakeDescriptor() const noexcept { return state_->wake.get(); }
+
+void AccessibilityBridge::setWindowFocused(bool focused) {
+    accesskit_unix_adapter_update_window_focus_state(state_->adapter.get(), focused);
+}
+
+void AccessibilityBridge::update(SceneAccessibilitySnapshot snapshot, AccessibilityWindow window) {
+    const bool focused = window.focused;
+    state_->publication.store(std::make_shared<const Publication>(Publication{std::move(snapshot), std::move(window)}));
+    accesskit_unix_adapter_update_if_active(
+        state_->adapter.get(), [](void* data) { return static_cast<State*>(data)->build(); }, state_.get());
+    accesskit_unix_adapter_update_window_focus_state(state_->adapter.get(), focused);
+}
+
+std::vector<NativeAccessibilityAction> AccessibilityBridge::takeActions() {
+    state_->wake.drain();
+    const std::scoped_lock lock(state_->mutex);
+    state_->queuedTextBytes = 0;
+    return std::exchange(state_->actions, {});
+}
