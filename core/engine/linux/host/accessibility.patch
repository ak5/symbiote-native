+            const auto props = std::dynamic_pointer_cast<const facebook::react::ViewProps>(node.getProps());
+            return isDisplayNone(node) ||
+                   (props && (props->accessibilityElementsHidden ||
+                              props->importantForAccessibility ==
+                                  facebook::react::ImportantForAccessibility::NoHideDescendants));
+        };
+        const auto props = std::dynamic_pointer_cast<const facebook::react::ViewProps>(target->getProps());
+        const auto ancestors = target->getFamily().getAncestors(*root);
+        if (isPruned(*target) ||
+            (props && props->importantForAccessibility == facebook::react::ImportantForAccessibility::No) ||
+            std::ranges::any_of(ancestors, [&](const auto& ancestor) { return isPruned(ancestor.first.get()); })) {
