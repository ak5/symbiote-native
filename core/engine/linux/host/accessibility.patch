+    RetainedScene scene;
+    scene.createSurfaceRoot(kSurfaceTag, Size{800, 600});
+    auto view = makeView(2, makeRect(10, 20, 100, 100));
+    addChild(scene, kSurfaceTag, view);
+    const auto identity = scene.accessibilitySnapshot().nodes.at(2).accessibilityId;
+    ASSERT_NE(identity, 0U);
+    view.layoutMetrics.frame.size.width = 200;
+    scene.updateNode(view);
+    EXPECT_EQ(scene.accessibilitySnapshot().nodes.at(2).accessibilityId, identity);
+    scene.removeChild(kSurfaceTag, view);
+    scene.deleteNode(2);
+    addChild(scene, kSurfaceTag, view);
+    EXPECT_NE(scene.accessibilitySnapshot().nodes.at(2).accessibilityId, identity);
+}
+
+TEST(AccessibilitySnapshotTest, FocusAndCaretAreCapturedWithTheSameNodeState) {
+    RetainedScene scene;
+    scene.createSurfaceRoot(kSurfaceTag, Size{800, 600});
+    auto props = textInputProps();
+    props->secureTextEntry = true;
+    props->editable = false;
+    addChild(scene, kSurfaceTag, makeTextInput(2, makeRect(10, 20, 200, 40), "secret", props));
+    scene.setFocus(2, true);
+    scene.setEditorState(
+        2, react_native_linux::SceneEditorState{.caretUtf16 = 3, .selectionBeginUtf16 = 1, .selectionEndUtf16 = 3});
+
+    const auto snapshot = scene.accessibilitySnapshot();
+    EXPECT_EQ(snapshot.focusedTag, 2);
+    ASSERT_TRUE(snapshot.geometry.at(2).editor.has_value());
+    EXPECT_EQ(snapshot.geometry.at(2).editor->caretUtf16, 3U);
+    EXPECT_EQ(snapshot.geometry.at(2).editor->selectionBeginUtf16, 1U);
+    EXPECT_TRUE(snapshot.nodes.at(2).editor->isSecure);
+    EXPECT_FALSE(snapshot.nodes.at(2).editor->isEditable);
