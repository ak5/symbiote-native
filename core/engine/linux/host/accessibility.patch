+
+using NativeNode = std::unique_ptr<accesskit_node, decltype(&accesskit_node_free)>;
+
+accesskit_node_id nativeId(const SceneNode& node) { return node.accessibilityId * 2; }
+
+accesskit_role roleOf(const SceneNode& node, std::string_view name) {
+    if (node.editor) {
+        if (node.editor->isSecure) {
+            return ACCESSKIT_ROLE_PASSWORD_INPUT;
+        }
+        if (name == "searchbox" || name == "search") {
+            return ACCESSKIT_ROLE_SEARCH_INPUT;
+        }
+        return node.editor->isMultiline ? ACCESSKIT_ROLE_MULTILINE_TEXT_INPUT : ACCESSKIT_ROLE_TEXT_INPUT;
+    }
+    const auto found = std::ranges::find(kRoles, name, &RoleMapping::name);
+    if (found != std::end(kRoles) && name != "none") {
+        return found->role;
+    }
+    if (node.componentName == "ScrollView") {
+        return ACCESSKIT_ROLE_SCROLL_VIEW;
+    }
+    if (node.image) {
+        return ACCESSKIT_ROLE_IMAGE;
+    }
+    if (node.switchControl) {
+        return ACCESSKIT_ROLE_SWITCH;
+    }
+    return ACCESSKIT_ROLE_GROUP;
+}
+
+accesskit_rect boundsOf(facebook::react::Rect bounds, float contentOffsetY) {
+    return {bounds.origin.x, bounds.origin.y + contentOffsetY, bounds.origin.x + bounds.size.width,
+            bounds.origin.y + bounds.size.height + contentOffsetY};
+}
+
+bool disabled(const SceneNode& node) {
+    return (node.accessibility.state && node.accessibility.state->disabled) ||
+           (node.switchControl && node.switchControl->isDisabled);
+}
+
+bool focusable(const SceneNode& node) {
+    return !disabled(node) && (node.accessibility.accessible || node.switchControl.has_value());
+}
+
+bool clickable(accesskit_role role) {
+    return role == ACCESSKIT_ROLE_BUTTON || role == ACCESSKIT_ROLE_LINK || role == ACCESSKIT_ROLE_SWITCH ||
+           role == ACCESSKIT_ROLE_CHECK_BOX || role == ACCESSKIT_ROLE_RADIO_BUTTON ||
+           role == ACCESSKIT_ROLE_MENU_ITEM || role == ACCESSKIT_ROLE_TAB;
+}
+
+class WakeDescriptor {
+public:
+    WakeDescriptor() : descriptor_(eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK)) {
+        if (descriptor_ < 0) {
+            throw std::system_error(errno, std::generic_category(), "Accessibility wake event");
+        }
+    }
+
+    ~WakeDescriptor() { close(descriptor_); }
+
+    WakeDescriptor(const WakeDescriptor&) = delete;
+    WakeDescriptor& operator=(const WakeDescriptor&) = delete;
+
+    int get() const noexcept { return descriptor_; }
+
+    void signal() const noexcept {
+        const uint64_t one = 1;
+        while (write(descriptor_, &one, sizeof(one)) < 0 && errno == EINTR) {
+        }
+    }
+
+    void drain() const noexcept {
+        uint64_t pending;
+        while (read(descriptor_, &pending, sizeof(pending)) < 0 && errno == EINTR) {
+        }
+    }
+
+private:
+    int descriptor_;
+};
+
+std::string accessibilityText(const SceneNode& source) {
+    if (!source.text || (source.editor && source.editor->isPlaceholder)) {
+        return {};
+    }
+    auto text = source.text->attributedString->getString();
+    if (source.editor && source.editor->isSecure) {
+        EditorModel protectedText;
+        protectedText.setSegmenter(segmentText);
+        protectedText.setSecure(true);
+        protectedText.setText(std::move(text));
+        return protectedText.displayText();
+    }
+    return text;
+}
+
+struct Publication {
+    SceneAccessibilitySnapshot snapshot;
+    AccessibilityWindow window;
+};
+
+class TreeBuilder {
+public:
+    explicit TreeBuilder(const Publication& publication)
+        : publication_(publication), update_(accesskit_tree_update_with_focus(kWindowId), accesskit_tree_update_free) {}
+
+    accesskit_tree_update* build() {
+        NativeNode root(accesskit_node_new(ACCESSKIT_ROLE_WINDOW), accesskit_node_free);
+        accesskit_node_set_label_with_length(root.get(), publication_.window.title.data(),
+                                             publication_.window.title.size());
+        accesskit_node_set_bounds(root.get(), boundsOf({.origin = {}, .size = publication_.window.size}, 0));
+        accesskit_node_set_clips_children(root.get());
+        const auto projected = describeAccessibilityTree(publication_.snapshot.nodes);
+        for (const auto& node : projected["nodes"]) {
+            collectExposedTags(node);
+        }
+        for (const auto& node : projected["nodes"]) {
+            append(root.get(), node);
+        }
+        accesskit_tree_update_push_node(update_.get(), kWindowId, root.release());
+        accesskit_tree_update_set_tree_info(update_.get(), accesskit_tree_info_new(kWindowId));
+        return update_.release();
+    }
+
+private:
+    void collectExposedTags(const folly::dynamic& description) {
+        const auto tag = static_cast<facebook::react::Tag>(description["tag"].asInt());
+        const auto found = publication_.snapshot.nodes.find(tag);
+        if (found == publication_.snapshot.nodes.end() || !publication_.snapshot.geometry.contains(tag) ||
+            found->second.accessibilityId == 0) {
+            return;
+        }
+        if (found->second.editor && !publication_.snapshot.geometry.at(tag).editor) {
+            return;
+        }
+        exposedTags_.insert(tag);
+        if (const auto* children = description.get_ptr("children")) {
+            for (const auto& child : *children) {
+                collectExposedTags(child);
+            }
+        }
+    }
+
+    void append(accesskit_node* parent, const folly::dynamic& description) {
+        const auto tag = static_cast<facebook::react::Tag>(description["tag"].asInt());
+        const auto found = publication_.snapshot.nodes.find(tag);
+        const auto geometry = publication_.snapshot.geometry.find(tag);
+        if (found == publication_.snapshot.nodes.end() || geometry == publication_.snapshot.geometry.end() ||
+            found->second.accessibilityId == 0) {
+            return;
+        }
+        const auto& source = found->second;
+        if (source.editor && !geometry->second.editor) {
+            return;
+        }
+        const auto identity = nativeId(source);
+        const auto role = roleOf(source, description["role"].asString());
+        NativeNode node(accesskit_node_new(role), accesskit_node_free);
+        accesskit_node_set_bounds(node.get(), boundsOf(geometry->second.bounds, publication_.window.contentOffsetY));
+        if (source.clipsChildren) {
+            accesskit_node_set_clips_children(node.get());
+        }
+        if (!source.accessibilityLabel.empty()) {
+            const auto& text = source.accessibilityLabel;
+            accesskit_node_set_label_with_length(node.get(), text.data(), text.size());
+        } else if (!source.editor || source.editor->isPlaceholder) {
+            if (const auto* name = description.get_ptr("name")) {
+                const auto& text = name->asString();
+                accesskit_node_set_label_with_length(node.get(), text.data(), text.size());
+            }
+        }
+        if (!source.accessibility.hint.empty()) {
+            const auto& text = source.accessibility.hint;
+            accesskit_node_set_description_with_length(node.get(), text.data(), text.size());
+        }
+        if (const auto* relations = description.get_ptr("labelledBy")) {
+            for (const auto& relation : *relations) {
+                const auto labelledBy = static_cast<facebook::react::Tag>(relation.asInt());
+                if (labelledBy != tag && exposedTags_.contains(labelledBy)) {
+                    accesskit_node_push_labelled_by(node.get(), nativeId(publication_.snapshot.nodes.at(labelledBy)));
+                }
+            }
+        }
+        if (disabled(source)) {
+            accesskit_node_set_disabled(node.get());
+        }
+        if (source.accessibility.state) {
+            const auto& state = *source.accessibility.state;
+            if (state.busy) {
+                accesskit_node_set_busy(node.get());
+            }
+            if (state.selected) {
+                accesskit_node_set_selected(node.get(), true);
+            }
+            if (state.expanded) {
+                accesskit_node_set_expanded(node.get(), *state.expanded);
+            }
+            if (state.checked != facebook::react::AccessibilityState::None) {
+                const auto value = state.checked == facebook::react::AccessibilityState::Mixed ? ACCESSKIT_TOGGLED_MIXED
+                                   : state.checked == facebook::react::AccessibilityState::Checked
+                                       ? ACCESSKIT_TOGGLED_TRUE
+                                       : ACCESSKIT_TOGGLED_FALSE;
+                accesskit_node_set_toggled(node.get(), value);
+            }
+        }
+        if (source.switchControl) {
+            accesskit_node_set_toggled(node.get(),
+                                       source.switchControl->isOn ? ACCESSKIT_TOGGLED_TRUE : ACCESSKIT_TOGGLED_FALSE);
+        }
+        if (source.editor && !source.editor->isEditable) {
+            accesskit_node_set_read_only(node.get());
+        }
+        if (source.accessibility.liveRegion == facebook::react::AccessibilityLiveRegion::Polite) {
+            accesskit_node_set_live(node.get(), ACCESSKIT_LIVE_POLITE);
+        } else if (source.accessibility.liveRegion == facebook::react::AccessibilityLiveRegion::Assertive) {
+            accesskit_node_set_live(node.get(), ACCESSKIT_LIVE_ASSERTIVE);
+        }
+        const auto& value = source.accessibility.value;
+        if (value.min) {
+            accesskit_node_set_min_numeric_value(node.get(), *value.min);
+        }
+        if (value.max) {
+            accesskit_node_set_max_numeric_value(node.get(), *value.max);
+        }
+        if (value.now) {
+            accesskit_node_set_numeric_value(node.get(), *value.now);
+        }
+        if (value.text) {
+            accesskit_node_set_value_with_length(node.get(), value.text->data(), value.text->size());
+        }
+        if (focusable(source)) {
+            accesskit_node_add_action(node.get(), ACCESSKIT_ACTION_FOCUS);
+            if (clickable(role)) {
+                accesskit_node_add_action(node.get(), ACCESSKIT_ACTION_CLICK);
+            }
+        }
+        if (source.editor) {
+            accesskit_node_add_action(node.get(), ACCESSKIT_ACTION_SET_TEXT_SELECTION);
+            if (source.editor->isEditable && !disabled(source)) {
+                accesskit_node_add_action(node.get(), ACCESSKIT_ACTION_SET_VALUE);
+            }
+        }
+        if (publication_.snapshot.focusedTag == tag) {
+            accesskit_tree_update_set_focus(update_.get(), identity);
+        }
+        if (const auto* children = description.get_ptr("children")) {
+            for (const auto& child : *children) {
+                append(node.get(), child);
+            }
+        }
+        appendText(node.get(), source, geometry->second);
+        accesskit_node_push_child(parent, identity);
+        accesskit_tree_update_push_node(update_.get(), identity, node.release());
+    }
+
+    void appendText(accesskit_node* parent, const SceneNode& source, const SceneAccessibilityGeometry& geometry) {
+        const auto text = accessibilityText(source);
+        if (text.empty() && !source.editor) {
+            return;
+        }
+        const auto segments = segmentText(text);
+        std::vector<uint8_t> lengths;
+        for (size_t index = 1; index < segments.graphemeStarts.size(); ++index) {
+            const auto bytes = segments.graphemeStarts[index] - segments.graphemeStarts[index - 1];
+            if (bytes > std::numeric_limits<uint8_t>::max()) {
+                // shortcut: AccessKit's uint8 ABI limits range navigation; use a label until wider lengths exist.
+                // AccessKit labels derive their name from value, not the label property.
+                accesskit_node_set_value_with_length(parent, text.data(), text.size());
+                if (source.editor) {
+                    NativeNode label(accesskit_node_new(ACCESSKIT_ROLE_LABEL), accesskit_node_free);
+                    accesskit_node_set_value_with_length(label.get(), text.data(), text.size());
+                    accesskit_node_set_bounds(label.get(),
+                                              boundsOf(geometry.bounds, publication_.window.contentOffsetY));
+                    const auto identity = nativeId(source) + 1;
+                    accesskit_node_push_child(parent, identity);
