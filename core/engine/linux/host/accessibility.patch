+void InputDispatcher::dispatchAccessibilityActions(const std::vector<NativeAccessibilityAction>& actions) {
+    if (actions.empty()) {
+        return;
+    }
+    syncFocusables();
+    const auto root = rootShadowNode();
+    if (!root) {
+        return;
+    }
+    for (const auto& action : actions) {
+        const auto target = shadowNodeWithTag(root, action.tag);
+        if (!target || !action.emitter || target->getEventEmitter() != action.emitter ||
+            accessibilityRoleOf(*target) != action.role) {
+            continue;
+        }
