+        std::make_shared<const std::vector<std::shared_ptr<const ShadowNode>>>(
+            std::vector<std::shared_ptr<const ShadowNode>>{target}));
+    commit(parent);
+    const auto pending = activate(target);
+    const PropsParserContext context{kSurfaceId, *contextContainer_};
+    const auto props = viewDescriptor_.cloneProps(
