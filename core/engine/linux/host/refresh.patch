+TEST(RefreshSceneTest, AccessibleControlHasNativeViewportGeometryAndBecomesBusyWhileRefreshing) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    auto snapshot = scene.accessibilitySnapshot();
+    ASSERT_TRUE(snapshot.nodes.contains(3));
+    EXPECT_TRUE(snapshot.nodes.at(3).accessibility.accessible);
+    EXPECT_EQ(snapshot.nodes.at(3).accessibility.accessibilityRole, "button");
+    EXPECT_EQ(snapshot.nodes.at(3).accessibilityLabel, "Refresh 雪");
+    EXPECT_EQ(snapshot.geometry.at(3).bounds, makeRect(108, 60, 24, 24));
+    ASSERT_TRUE(snapshot.nodes.at(3).accessibility.state.has_value());
+    EXPECT_FALSE(snapshot.nodes.at(3).accessibility.state->busy);
+    scene.setRefreshControlState(3, control.eventEmitter, true, 0);
+    snapshot = scene.accessibilitySnapshot();
+    EXPECT_TRUE(snapshot.nodes.at(3).accessibility.state->busy);
+    EXPECT_TRUE(snapshot.nodes.at(3).accessibility.state->disabled);
+}
+
+TEST(RefreshSceneTest, KeyboardFocusRevealsAClippedControlAndItsVisibleFocusRing) {
+    auto scene = refreshScene(refreshView());
+    scene.setFocus(3, true);
+    const auto snapshot = scene.snapshot();
+    const auto indicator = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 3 && primitive.activityIndicator.has_value(); });
+    ASSERT_NE(indicator, snapshot.end());
+    EXPECT_TRUE(indicator->focusRing);
+    ASSERT_FALSE(indicator->clips.empty());
+    EXPECT_EQ(indicator->clips.back().frame, makeRect(20, 30, 200, 160));
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {120, 72}).tag, 3);
+    scene.setFocus(3, false);
+    EXPECT_EQ(scene.findNodeAtPoint(kSurfaceTag, {120, 72}).tag, 3);
+}
+
+TEST(RefreshSceneTest, RefreshingDrawsTheIndicatorAndTitleAtTheViewportInsteadOfTheContentOffset) {
+    const auto scene = refreshScene(refreshView(true));
+    const auto snapshot = scene.snapshot();
+    const auto indicator = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 3 && primitive.activityIndicator.has_value(); });
+    ASSERT_NE(indicator, snapshot.end());
+    EXPECT_EQ(indicator->frame, makeRect(108, 60, 24, 24));
+    EXPECT_EQ(indicator->activityIndicator->colorArgb, kRedArgb);
+    const auto title = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 3 && primitive.text.has_value(); });
+    ASSERT_NE(title, snapshot.end());
+    EXPECT_EQ(title->text->attributedString->getString(), "Refresh 雪");
+    EXPECT_EQ(title->text->frame, makeRect(20, 86, 200, 22));
+    const auto& attributes = title->text->attributedString->getFragments().front().textAttributes;
+    EXPECT_EQ(attributes.foregroundColor, blue());
+}
+
+TEST(RefreshSceneTest, NativePullDamagesTheViewportAndControlledStopErasesIt) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    EXPECT_TRUE(scene.setRefreshControlState(3, control.eventEmitter, false, 32));
+    EXPECT_FALSE(scene.takeDamage().empty());
+    EXPECT_TRUE(std::ranges::any_of(scene.snapshot(), [](const auto& primitive) {
+        return primitive.tag == 3 && primitive.activityIndicator.has_value();
+    }));
+    EXPECT_TRUE(scene.setRefreshControlState(3, control.eventEmitter, false, 0));
+    EXPECT_FALSE(scene.takeDamage().empty());
+    EXPECT_TRUE(std::ranges::none_of(scene.snapshot(), [](const auto& primitive) { return primitive.tag == 3; }));
+}
+
+TEST(RefreshSceneTest, RepeatingTheSameNativeStateCreatesNoNewDamage) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    scene.setRefreshControlState(3, control.eventEmitter, true, 0);
+    scene.takeDamage();
+    EXPECT_FALSE(scene.setRefreshControlState(3, control.eventEmitter, true, 0));
+    EXPECT_TRUE(scene.takeDamage().empty());
+}
+
+TEST(RefreshSceneTest, UnrelatedCommitsRetainTheNativePullAndRefreshingState) {
+    auto control = refreshView();
+    auto scene = refreshScene(control);
+    scene.setRefreshControlState(3, control.eventEmitter, true, 0);
+    scene.updateNode(control);
+    EXPECT_TRUE(std::ranges::any_of(scene.snapshot(), [](const auto& primitive) {
+        return primitive.tag == 3 && primitive.activityIndicator.has_value();
+    }));
+    auto accepted = std::make_shared<PullToRefreshViewProps>();
+    accepted->refreshing = true;
+    control.props = accepted;
+    scene.updateNode(control);
+    control.props = std::make_shared<PullToRefreshViewProps>();
+    scene.updateNode(control);
+    EXPECT_FALSE(scene.takeDamage().empty());
+    EXPECT_TRUE(std::ranges::none_of(scene.snapshot(), [](const auto& primitive) { return primitive.tag == 3; }));
+}
+
+TEST(RefreshSceneTest, OldEmitterCannotChangeAReplacementControlOrTransferNativeState) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    scene.setRefreshControlState(3, control.eventEmitter, true, 0);
+    scene.updateNode(refreshView());
+    EXPECT_FALSE(scene.setRefreshControlState(3, control.eventEmitter, true, 0));
+    EXPECT_TRUE(std::ranges::none_of(scene.snapshot(), [](const auto& primitive) { return primitive.tag == 3; }));
+}
+
+TEST(RefreshSceneTest, InvalidNativeDistancesAreRejectedWithoutChangingPixels) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    for (double distance : {-1.0, std::numeric_limits<double>::infinity(), std::numeric_limits<double>::quiet_NaN()}) {
+        EXPECT_FALSE(scene.setRefreshControlState(3, control.eventEmitter, true, distance));
+    }
+    EXPECT_TRUE(scene.takeDamage().empty());
+    EXPECT_TRUE(std::ranges::none_of(scene.snapshot(), [](const auto& primitive) { return primitive.tag == 3; }));
+}
+
+TEST(RefreshSceneTest, OnlyAnActiveRefreshAdvancesTheNativeIndicatorClock) {
+    const auto control = refreshView();
+    auto scene = refreshScene(control);
+    scene.setRefreshControlState(3, control.eventEmitter, false, 40);
+    scene.takeDamage();
+    EXPECT_FALSE(scene.advanceControlAnimations(16));
+    EXPECT_TRUE(scene.takeDamage().empty());
+    scene.setRefreshControlState(3, control.eventEmitter, true, 0);
+    scene.takeDamage();
+    EXPECT_TRUE(scene.advanceControlAnimations(16));
+    EXPECT_FALSE(scene.takeDamage().empty());
+    const auto snapshot = scene.snapshot();
+    const auto indicator = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 3 && primitive.activityIndicator.has_value(); });
+    ASSERT_NE(indicator, snapshot.end());
+    EXPECT_DOUBLE_EQ(indicator->activityIndicator->elapsedMilliseconds, 16);
+}
