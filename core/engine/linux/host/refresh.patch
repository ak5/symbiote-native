+        // A single delta may both reach the top and continue into a pull.
+        const double toTop = delta < 0.0 ? std::max(delta, top - offset) : 0.0;
+        const bool atTop = offset + toTop <= top;
+        delta = toTop + target->refreshGesture.drag(delta - toTop, atTop);
+        publishRefreshControl(*target);
+    }
+    axis.pendingDrag += delta;
     target->isFingerDown = true;
+}
+
+void ScrollController::syncRefreshControl(ScrollTarget& target,
+                                          const facebook::react::ScrollViewShadowNode& scrollView) {
+    std::shared_ptr<const facebook::react::PullToRefreshViewShadowNode> refresh;
+    for (const auto& child : scrollView.getChildren()) {
+        refresh = std::dynamic_pointer_cast<const facebook::react::PullToRefreshViewShadowNode>(child);
+        if (refresh) {
+            break;
+        }
+    }
+    const bool replaced =
+        !refresh || !target.refreshControl || &refresh->getFamily() != &target.refreshControl->getFamily();
+    if (replaced) {
+        target.refreshGesture = RefreshGesture{};
+        target.committedRefreshing = refresh && refresh->getConcreteProps().refreshing;
+        target.refreshGesture.setRefreshing(target.committedRefreshing);
+    } else if (refresh->getConcreteProps().refreshing != target.committedRefreshing) {
+        target.committedRefreshing = refresh->getConcreteProps().refreshing;
+        target.refreshGesture.setRefreshing(target.committedRefreshing);
+    }
+    target.refreshControl = std::move(refresh);
+    if (!scrollView.getConcreteProps().scrollEnabled ||
+        scrollView.getLayoutMetrics().displayType == facebook::react::DisplayType::None) {
+        target.refreshGesture.cancelPull();
+    }
+    publishRefreshControl(target);
+}
+
+void ScrollController::publishRefreshControl(const ScrollTarget& target) {
+    if (mountingManager_ && target.refreshControl) {
+        mountingManager_->setRefreshControlState(
+            target.refreshControl->getTag(), target.refreshControl->getEventEmitter(),
+            target.refreshGesture.isRefreshing(), target.refreshGesture.distance());
+    }
+}
+
+void ScrollController::routeRefreshCommand(const SceneCommand& command) {
+    const bool request = command.name == "requestRefresh";
+    if (!command.args.isArray() ||
+        (request ? !command.args.empty() : command.args.size() != 1 || !command.args[0].isBool())) {
+        return;
+    }
+    const auto root = rootShadowNode();
+    const auto node = std::dynamic_pointer_cast<const facebook::react::PullToRefreshViewShadowNode>(
+        shadowNodeWithTag(root, command.tag));
+    if (!node || !command.emitter || command.emitter != node->getEventEmitter()) {
+        return;
+    }
+    if (request && modalRootTag_ != 0 && !shadowNodeWithTag(shadowNodeWithTag(root, modalRootTag_), command.tag)) {
+        return;
+    }
+    const auto ancestors = node->getFamily().getAncestors(*root);
+    if (ancestors.empty()) {
+        return;
+    }
+    const auto scrollView = scrollViewWithTag(ancestors.back().first.get().getTag());
+    if (!scrollView ||
+        (request && (!scrollView->getConcreteProps().scrollEnabled ||
+                     scrollView->getLayoutMetrics().displayType == facebook::react::DisplayType::None))) {
+        return;
+    }
+    const auto props = std::dynamic_pointer_cast<const facebook::react::ViewProps>(node->getProps());
+    if (request && props && props->accessibilityState && props->accessibilityState->disabled) {
+        return;
+    }
+    auto& target = acquireMaintainedNode(scrollView);
+    syncRefreshControl(target, *scrollView);
+    if (target.refreshControl && &target.refreshControl->getFamily() == &node->getFamily()) {
+        if (request) {
+            if (!target.refreshGesture.requestRefresh()) {
+                return;
+            }
+            publishRefreshControl(target);
+            target.refreshControl->getConcreteEventEmitter().onRefresh({});
+        } else {
+            target.refreshGesture.setRefreshing(command.args[0].asBool());
+            publishRefreshControl(target);
+        }
+    }
 }
 
