+class RefreshControllerTest : public TextInputFieldFixture {
+protected:
+    using Node = std::shared_ptr<const facebook::react::ShadowNode>;
+    using Children = std::vector<Node>;
+
+    void SetUp() override {
+        TextInputFieldFixture::SetUp();
+        mountingManager_->startSurface(kSurfaceId, {400, 300});
+        controller_ = std::make_unique<ScrollController>(uiManager_, kSurfaceId);
+        controller_->setModalRoot(0, mountingManager_);
+    }
+
+    Node control(bool refreshing = false) {
+        return makeConfiguredShadowNode(refreshDescriptor_, 4, kSurfaceId, contextContainer_,
+                                        folly::dynamic::object("refreshing", refreshing)("collapsable", false)(
+                                            "accessibilityLabel", "Refresh data"),
+                                        std::make_shared<const Children>());
+    }
+
+    Node scroll(const Node& refresh, bool enabled = true) {
+        const auto content = makeConfiguredShadowNode(viewDescriptor_, 6, kSurfaceId, contextContainer_,
+                                                      folly::dynamic::object("width", 200)("height", 600),
+                                                      std::make_shared<const Children>());
+        return makeConfiguredShadowNode(scrollDescriptor_, 2, kSurfaceId, contextContainer_,
+                                        folly::dynamic::object("width", 200)("height", 160)("scrollEnabled", enabled),
+                                        std::make_shared<const Children>(Children{content, refresh}));
+    }
+
+    void commit(const Node& node) {
+        shadowTree_->commit(
+            [&](const facebook::react::RootShadowNode& root) {
+                const PropsParserContext context{kSurfaceId, *contextContainer_};
+                const auto sized = root.clone(context, exactSurfaceConstraints({400, 300}), LayoutContext{});
+                return cloneRootWithChildren(*sized, std::make_shared<const Children>(Children{node}));
+            },
+            facebook::react::ShadowTreeCommitOptions{.enableStateReconciliation = false, .mountSynchronously = true});
+        auto transaction = shadowTree_->getMountingCoordinator()->pullTransaction();
+        ASSERT_TRUE(transaction.has_value());
+        mountingManager_->executeMount(kSurfaceId, std::move(*transaction));
+    }
+
+    void pull(double delta, InputEventKind kind = InputEventKind::PointerScrollContinuous,
+              ScrollAxisKind axis = ScrollAxisKind::Vertical) {
+        controller_->dispatch(
+            {InputEvent{.kind = kind, .surfacePoint = {50, 50}, .scrollAxis = axis, .scrollAmount = delta}});
+    }
+
+    void release() {
+        controller_->dispatch({InputEvent{.kind = InputEventKind::PointerScrollStop}});
+        controller_->advance(16);
+    }
+
+    void command(const Node& node, std::string name, folly::dynamic args) {
+        controller_->dispatchCommands({SceneCommand{.tag = node->getTag(),
+                                                    .name = std::move(name),
+                                                    .args = std::move(args),
+                                                    .emitter = node->getEventEmitter()}});
+    }
+
+    size_t refreshEvents() const { return std::ranges::count(*recordedEventTypes_, "topRefresh"); }
+
+    facebook::react::PullToRefreshViewComponentDescriptor refreshDescriptor_{
+        {.eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    facebook::react::ScrollViewComponentDescriptor scrollDescriptor_{
+        {.eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    facebook::react::ViewComponentDescriptor viewDescriptor_{
+        {.eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    facebook::react::ModalHostViewComponentDescriptor modalDescriptor_{
+        {.eventDispatcher = eventDispatcher_, .contextContainer = contextContainer_, .flavor = nullptr}};
+    std::unique_ptr<ScrollController> controller_;
+};
+
+TEST_F(RefreshControllerTest, ARealTopEdgePullEmitsRefreshOnlyAfterRelease) {
+    const auto refresh = control();
+    commit(scroll(refresh));
+    pull(-128);
+    EXPECT_EQ(refreshEvents(), 0);
+    release();
+    EXPECT_EQ(refreshEvents(), 1);
+    const auto state = mountingManager_->accessibilitySnapshot();
+    ASSERT_TRUE(state.nodes.contains(4));
+    ASSERT_TRUE(state.nodes.at(4).accessibility.state.has_value());
+    EXPECT_TRUE(state.nodes.at(4).accessibility.state->busy);
+}
+
+TEST_F(RefreshControllerTest, WheelAndHorizontalInputDoNotRequestRefresh) {
+    commit(scroll(control()));
+    pull(-20, InputEventKind::PointerScrollDiscrete);
+    release();
+    pull(-200, InputEventKind::PointerScrollContinuous, ScrollAxisKind::Horizontal);
+    release();
+    EXPECT_EQ(refreshEvents(), 0);
+}
+
+TEST_F(RefreshControllerTest, BelowThresholdReleaseAndReversalCancelTheRequest) {
+    commit(scroll(control()));
+    pull(-100);
+    release();
+    EXPECT_EQ(refreshEvents(), 0);
+    pull(-160);
+    pull(100);
+    release();
+    EXPECT_EQ(refreshEvents(), 0);
+}
+
+TEST_F(RefreshControllerTest, ARejectedControlledRefreshCanBePulledAgain) {
+    const auto refresh = control();
+    commit(scroll(refresh));
+    pull(-128);
+    release();
+    ASSERT_EQ(refreshEvents(), 1);
+    command(refresh, "setNativeRefreshing", folly::dynamic::array(false));
+    pull(-128);
+    release();
+    EXPECT_EQ(refreshEvents(), 2);
+}
+
+TEST_F(RefreshControllerTest, ProgrammaticRefreshingAndRepeatedActionsNeverDuplicateRefresh) {
+    const auto refresh = control(true);
+    commit(scroll(refresh));
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    pull(-200);
+    release();
+    EXPECT_EQ(refreshEvents(), 0);
+    command(refresh, "setNativeRefreshing", folly::dynamic::array(false));
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 1);
+}
+
+TEST_F(RefreshControllerTest, ReplacingTheControlRevokesAnOldQueuedCommand) {
+    const auto original = control();
+    const auto parent = scroll(original);
+    commit(parent);
+    command(original, "requestRefresh", folly::dynamic::array());
+    ASSERT_EQ(refreshEvents(), 1);
+    const auto replacement = control();
+    auto children = parent->getChildren();
+    children.back() = replacement;
+    commit(parent->clone(ShadowNodeFragment{.children = std::make_shared<const Children>(std::move(children))}));
+    command(original, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 1);
+    command(replacement, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 2);
+}
+
+TEST_F(RefreshControllerTest, InvalidCommandArgumentsCannotChangeNativeRefreshState) {
+    const auto refresh = control();
+    commit(scroll(refresh));
+    command(refresh, "requestRefresh", folly::dynamic::array(true));
+    command(refresh, "setNativeRefreshing", folly::dynamic::array("true"));
+    command(refresh, "setNativeRefreshing", folly::dynamic::object());
+    EXPECT_EQ(refreshEvents(), 0);
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 1);
+}
+
+TEST_F(RefreshControllerTest, ADisabledScrollViewRejectsGesturesAndAccessibleRefreshRequests) {
+    const auto refresh = control();
+    commit(scroll(refresh, false));
+    pull(-200);
+    release();
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 0);
+}
+
+TEST_F(RefreshControllerTest, OpeningAModalCancelsABackgroundPullAndRejectsItsQueuedAction) {
+    const auto refresh = control();
+    const auto modal =
+        makeConfiguredShadowNode(modalDescriptor_, 8, kSurfaceId, contextContainer_,
+                                 folly::dynamic::object("visible", true), std::make_shared<const Children>());
+    const auto parent = makeConfiguredShadowNode(viewDescriptor_, 10, kSurfaceId, contextContainer_,
+                                                 folly::dynamic::object("width", 400)("height", 300),
+                                                 std::make_shared<const Children>(Children{scroll(refresh), modal}));
+    commit(parent);
+    pull(-160);
+    controller_->setModalRoot(8, mountingManager_);
+    release();
+    command(refresh, "requestRefresh", folly::dynamic::array());
+    EXPECT_EQ(refreshEvents(), 0);
+}
+
+TEST_F(RefreshControllerTest, KeyboardActivationUsesTheRealNativeRefreshCommandAndEmitter) {
+    const auto refresh = control();
+    commit(scroll(refresh));
+    InputDispatcher keyboard(uiManager_, mountingManager_, kSurfaceId);
+    keyboard.dispatchCommands({SceneCommand{.tag = 4, .name = "focus", .args = folly::dynamic::object()}});
+    keyboard.dispatch({InputEvent{.kind = InputEventKind::KeyPress, .key = "Enter"}});
+    controller_->dispatchCommands(mountingManager_->takeCommands());
+    EXPECT_EQ(refreshEvents(), 1);
+}
+
+TEST_F(RefreshControllerTest, ScreenReaderActivationUsesTheSameRevocableNativePath) {
+    const auto refresh = control();
+    commit(scroll(refresh));
+    InputDispatcher keyboard(uiManager_, mountingManager_, kSurfaceId);
+    keyboard.dispatchAccessibilityActions({NativeAccessibilityAction{.kind = NativeAccessibilityAction::Kind::Activate,
+                                                                     .tag = 4,
