+#include "FantomTester.h"
+
+#include <algorithm>
+#include <gtest/gtest.h>
+
+namespace react_native_linux {
+namespace {
+
+constexpr char kRefreshSetup[] = R"JAVASCRIPT(
+if (!globalThis.__nativeComponentRegistry__hasComponent('PullToRefreshView')) {
+  throw new Error('PullToRefreshView has no native registration');
+}
+globalThis.fabric = globalThis.nativeFabricUIManager;
+globalThis.events = [];
+globalThis.mode = 'accept';
+globalThis.handles = [];
+globalThis.node = (tag, name, props) => {
+  const handle = {stateNode: {node: null}};
+  handles.push(handle);
+  handle.stateNode.node = fabric.createNode(tag, name, 1, props, handle);
+  return handle.stateNode.node;
+};
+fabric.registerEventHandler((target, type) => {
+  events.push(type);
+  if (type === 'topRefresh') {
+    if (mode === 'accept') {
+      subject = fabric.cloneNodeWithNewProps(subject, {refreshing: true});
+      commit();
+    } else {
+      fabric.dispatchCommand(subject, 'setNativeRefreshing', [false]);
+    }
+  }
+});
+globalThis.subject = node(4, 'PullToRefreshView', {
+  refreshing: false, onRefresh: true, collapsable: false,
+  tintColor: 0xffff0000, titleColor: 0xff0000ff,
+  title: 'Refresh 雪', progressViewOffset: 10,
+});
+globalThis.content = node(6, 'View', {
+  width: 200, height: 600, backgroundColor: 0xff142536, collapsable: false,
+});
+globalThis.scroll = node(2, 'ScrollView', {
+  left: 20, top: 30, width: 200, height: 160, collapsable: false,
+});
+globalThis.commit = () => {
+  scroll = fabric.cloneNodeWithNewChildren(scroll);
+  fabric.appendChild(scroll, content);
+  fabric.appendChild(scroll, subject);
+  const children = fabric.createChildSet();
+  fabric.appendChildToSet(children, scroll);
+  fabric.completeRoot(1, children);
+};
+commit();
+)JAVASCRIPT";
+
+bool hasRefreshIndicator(const FantomTester& tester) {
+    return std::ranges::any_of(tester.snapshotScene(), [](const auto& primitive) {
+        return primitive.tag == 4 && primitive.activityIndicator.has_value();
+    });
+}
+
+void pullAndRelease(FantomTester& tester, double delta) {
+    tester.advanceModalFrame(16, {
+                                     InputEvent{.kind = InputEventKind::PointerScrollContinuous,
+                                                .surfacePoint = {50, 50},
+                                                .scrollAmount = delta},
+                                     InputEvent{.kind = InputEventKind::PointerScrollStop},
+                                 });
+}
+
+TEST(RefreshHostTest, StockRegistrationAndCommandsPaintNativeIndicatorAndTitleWithoutAnEvent) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kRefreshSetup);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    tester.runTask("fabric.dispatchCommand(subject, 'setNativeRefreshing', [true]);");
+    tester.advanceModalFrame(0);
+    const auto snapshot = tester.snapshotScene();
+    const auto indicator = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 4 && primitive.activityIndicator.has_value(); });
+    ASSERT_NE(indicator, snapshot.end());
+    EXPECT_EQ(indicator->frame, (facebook::react::Rect{{108, 60}, {24, 24}}));
+    EXPECT_EQ(indicator->activityIndicator->colorArgb, 0xFFFF0000U);
+    const auto title = std::ranges::find_if(
+        snapshot, [](const auto& primitive) { return primitive.tag == 4 && primitive.text.has_value(); });
+    ASSERT_NE(title, snapshot.end());
+    EXPECT_EQ(title->text->attributedString->getString(), "Refresh 雪");
+    tester.runTask(
+        "if (events.includes('topRefresh')) throw new Error('Programmatic refresh emitted a gesture event');");
+    tester.runTask("fabric.dispatchCommand(subject, 'setNativeRefreshing', [false]);");
+    tester.advanceModalFrame(0);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(RefreshHostTest, RealGestureReachesHermesAndTheControlledPropStopsTheNativeIndicator) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kRefreshSetup);
+    pullAndRelease(tester, -128);
+    EXPECT_TRUE(hasRefreshIndicator(tester));
+    tester.runTask(R"JAVASCRIPT(
+if (events.filter(type => type === 'topRefresh').length !== 1) throw new Error('Missing native refresh event');
+subject = fabric.cloneNodeWithNewProps(subject, {refreshing: false});
+commit();
+)JAVASCRIPT");
+    tester.advanceModalFrame(0);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    pullAndRelease(tester, -128);
+    tester.runTask(
+        "if (events.filter(type => type === 'topRefresh').length !== 2) throw new Error('Next refresh was lost');");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(RefreshHostTest, ARejectedGestureStopsThroughTheRealFabricCommandAndCanBeRetried) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kRefreshSetup);
+    tester.runTask("mode = 'reject';");
+    pullAndRelease(tester, -128);
+    tester.advanceModalFrame(0);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    pullAndRelease(tester, -128);
+    tester.advanceModalFrame(0);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    tester.runTask("if (events.filter(type => type === 'topRefresh').length !== 2) throw new Error('Rejected handshake "
+                   "did not reset');");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
+
+TEST(RefreshHostTest, AShortPullDoesNotRefreshAndUnmountRevokesQueuedCommands) {
+    FantomTester tester{{400, 300}};
+    tester.runTask(kRefreshSetup);
+    pullAndRelease(tester, -100);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    tester.runTask(R"JAVASCRIPT(
+if (events.includes('topRefresh')) throw new Error('Short pull refreshed');
+fabric.dispatchCommand(subject, 'requestRefresh', []);
+const empty = fabric.createChildSet();
+fabric.completeRoot(1, empty);
+)JAVASCRIPT");
+    tester.advanceModalFrame(0);
+    EXPECT_FALSE(hasRefreshIndicator(tester));
+    tester.runTask("if (events.includes('topRefresh')) throw new Error('Unmounted refresh accepted an old command');");
+    EXPECT_FALSE(tester.hasReportedFatalError());
+}
