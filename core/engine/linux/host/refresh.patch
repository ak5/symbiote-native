--- /dev/null
+++ b/packages/core/src/RefreshGesture.cpp
@@ -0,0 +1,55 @@
+#include "RefreshGesture.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace react_native_linux {
+
+double RefreshGesture::drag(double delta, bool atTop) {
+    if (!std::isfinite(delta)) {
+        return 0.0;
+    }
+    if (refreshing_) {
+        return delta;
+    }
+    if (!atTop) {
+        cancelPull();
+        return delta;
+    }
+    constexpr double resistance = 0.5;
+    if (delta < 0.0) {
+        distance_ = std::min(distance_ - delta * resistance, kRefreshTriggerDistance * 2.0);
+        return 0.0;
+    }
+    const double consumed = std::min(delta, distance_ / resistance);
+    distance_ -= consumed * resistance;
+    return delta - consumed;
+}
+
+bool RefreshGesture::release() {
+    const bool triggered = !refreshing_ && distance_ >= kRefreshTriggerDistance;
+    distance_ = 0.0;
+    refreshing_ = refreshing_ || triggered;
+    return triggered;
+}
+
+bool RefreshGesture::requestRefresh() {
+    if (refreshing_) {
+        return false;
+    }
+    setRefreshing(true);
+    return true;
+}
+
+void RefreshGesture::cancelPull() { distance_ = 0.0; }
+
+void RefreshGesture::setRefreshing(bool refreshing) {
+    refreshing_ = refreshing;
+    cancelPull();
+}
+
+bool RefreshGesture::isRefreshing() const noexcept { return refreshing_; }
+
+double RefreshGesture::distance() const noexcept { return distance_; }
+
+} // namespace react_native_linux
