+
+namespace react_native_linux {
+
+TEST(RefreshGestureTest, BelowThresholdReleaseCancelsWithoutRefreshing) {
+    RefreshGesture gesture;
+    EXPECT_DOUBLE_EQ(gesture.drag(-100.0, true), 0.0);
+    EXPECT_DOUBLE_EQ(gesture.distance(), 50.0);
+    EXPECT_FALSE(gesture.release());
+    EXPECT_DOUBLE_EQ(gesture.distance(), 0.0);
+    EXPECT_FALSE(gesture.isRefreshing());
+}
+
+TEST(RefreshGestureTest, ThresholdReleaseTriggersExactlyOnce) {
+    RefreshGesture gesture;
+    gesture.drag(-128.0, true);
+    EXPECT_TRUE(gesture.release());
+    EXPECT_TRUE(gesture.isRefreshing());
+    EXPECT_FALSE(gesture.release());
+    EXPECT_DOUBLE_EQ(gesture.drag(-200.0, true), -200.0);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, ReversingDirectionCancelsThePullBeforeScrolling) {
+    RefreshGesture gesture;
+    gesture.drag(-160.0, true);
+    EXPECT_DOUBLE_EQ(gesture.drag(60.0, true), 0.0);
+    EXPECT_DOUBLE_EQ(gesture.distance(), 50.0);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, ReturningThroughZeroPreservesTheRemainingScrollDelta) {
+    RefreshGesture gesture;
+    gesture.drag(-40.0, true);
+    EXPECT_DOUBLE_EQ(gesture.drag(100.0, true), 60.0);
+    EXPECT_DOUBLE_EQ(gesture.distance(), 0.0);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, ScrollingAwayFromTheTopDoesNotStealInput) {
+    RefreshGesture gesture;
+    EXPECT_DOUBLE_EQ(gesture.drag(-200.0, false), -200.0);
+    EXPECT_FALSE(gesture.release());
+    gesture.drag(-200.0, true);
+    EXPECT_DOUBLE_EQ(gesture.drag(-20.0, false), -20.0);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, ControlledStopAllowsAnotherIndependentRefresh) {
+    RefreshGesture gesture;
+    gesture.drag(-128.0, true);
+    ASSERT_TRUE(gesture.release());
+    gesture.setRefreshing(false);
+    EXPECT_FALSE(gesture.isRefreshing());
+    gesture.drag(-128.0, true);
+    EXPECT_TRUE(gesture.release());
+}
+
+TEST(RefreshGestureTest, ProgrammaticRefreshDoesNotGenerateAGestureEvent) {
+    RefreshGesture gesture;
+    gesture.setRefreshing(true);
+    EXPECT_TRUE(gesture.isRefreshing());
+    EXPECT_DOUBLE_EQ(gesture.distance(), 0.0);
+    EXPECT_FALSE(gesture.release());
+    gesture.setRefreshing(false);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, AccessibleRequestsShareTheGestureDuplicateGuard) {
+    RefreshGesture gesture;
+    EXPECT_TRUE(gesture.requestRefresh());
+    EXPECT_FALSE(gesture.requestRefresh());
+    gesture.drag(-200, true);
+    EXPECT_FALSE(gesture.release());
+    gesture.setRefreshing(false);
+    EXPECT_TRUE(gesture.requestRefresh());
+}
+
+TEST(RefreshGestureTest, AccessibleRequestReplacesAnUnfinishedPull) {
+    RefreshGesture gesture;
+    gesture.drag(-100, true);
+    EXPECT_TRUE(gesture.requestRefresh());
+    EXPECT_DOUBLE_EQ(gesture.distance(), 0);
+    EXPECT_FALSE(gesture.release());
+}
+
+TEST(RefreshGestureTest, CancellationClearsPullButDoesNotStopAnActiveRefresh) {
+    RefreshGesture gesture;
+    gesture.drag(-200.0, true);
+    gesture.cancelPull();
+    EXPECT_FALSE(gesture.release());
+    gesture.setRefreshing(true);
+    gesture.cancelPull();
+    EXPECT_TRUE(gesture.isRefreshing());
+}
+
+TEST(RefreshGestureTest, InvalidDeltasCannotPoisonTheNextGesture) {
+    RefreshGesture gesture;
+    for (double delta : {std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity(),
+                         std::numeric_limits<double>::quiet_NaN()}) {
+        EXPECT_DOUBLE_EQ(gesture.drag(delta, true), 0.0);
+        EXPECT_DOUBLE_EQ(gesture.distance(), 0.0);
+    }
+    gesture.drag(-128.0, true);
+    EXPECT_TRUE(gesture.release());
+}
+
+TEST(RefreshGestureTest, VeryLargeFinitePullIsBoundedAndCanBeCancelled) {
+    RefreshGesture gesture;
+    gesture.drag(-std::numeric_limits<double>::max(), true);
+    EXPECT_DOUBLE_EQ(gesture.distance(), kRefreshTriggerDistance * 2.0);
+    EXPECT_DOUBLE_EQ(gesture.drag(std::numeric_limits<double>::max(), true), std::numeric_limits<double>::max());
+    EXPECT_DOUBLE_EQ(gesture.distance(), 0.0);
+    EXPECT_FALSE(gesture.release());
+}
+
