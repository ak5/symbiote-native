@@ -0,0 +1,37 @@
+#pragma once
+
+#include <cstddef>
+#include <string_view>
+
+namespace react_native_linux {
+
+inline bool validClipboardUtf8(std::string_view text) {
+    size_t offset = 0;
+    while (offset < text.size()) {
+        const auto first = static_cast<unsigned char>(text[offset++]);
+        if (first < 0x80) {
+            continue;
+        }
+        const int remaining = first >= 0xC2 && first <= 0xDF   ? 1
+                              : first >= 0xE0 && first <= 0xEF ? 2
+                              : first >= 0xF0 && first <= 0xF4 ? 3
+                                                               : -1;
+        if (remaining < 0 || text.size() - offset < static_cast<size_t>(remaining)) {
+            return false;
+        }
+        const auto second = static_cast<unsigned char>(text[offset]);
+        if ((first == 0xE0 && second < 0xA0) || (first == 0xED && second >= 0xA0) || (first == 0xF0 && second < 0x90) ||
+            (first == 0xF4 && second >= 0x90)) {
+            return false;
+        }
+        for (int count = 0; count < remaining; ++count) {
+            const auto continuation = static_cast<unsigned char>(text[offset++]);
+            if (continuation < 0x80 || continuation > 0xBF) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+} // namespace react_native_linux
