+#pragma once
+
+#include "Clipboard.h"
+
+#include <cstdint>
+#include <memory>
+
+struct wl_display;
+struct wl_data_device_manager;
+struct wl_seat;
+
+namespace react_native_linux {
+
+/**
+ * Owns one data-device manager and a private queue on the window's connection.
+ * Only its worker dispatches clipboard proxies. Input callbacks publish focus and
+ * qualifying press serials atomically; frame callers poll the result; JS callers may await a transfer.
+ * The window must stop this worker before destroying its seat or display.
+ */
+class WaylandClipboard final : public ClipboardBackend {
+public:
+    WaylandClipboard(wl_display* display, wl_data_device_manager* manager, wl_seat* seat);
+    ~WaylandClipboard() override;
+    void readText(ClipboardReadCallback complete) override;
+    void writeText(std::string text, ClipboardWriteCallback complete) override;
+    void setFocus(bool focused) noexcept;
+    void setSelectionSerial(uint32_t serial) noexcept;
+    void stop() noexcept;
+
+private:
+    struct State;
+    std::unique_ptr<State> state_;
+};
+
+} // namespace react_native_linux
