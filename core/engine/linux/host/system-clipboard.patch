+
+namespace react_native_linux {
+namespace {
+
+class RecordingClipboard final : public ClipboardBackend {
+public:
+    void readText(ClipboardReadCallback complete) override {
+        std::optional<std::string> text;
+        {
+            const std::scoped_lock lock(mutex_);
+            if (available) {
+                text = text_;
+            }
+        }
+        if (onRead) {
+            onRead();
+        }
+        complete(std::move(text));
+    }
+
+    void writeText(std::string text, ClipboardWriteCallback complete) override {
+        bool accepted;
+        {
+            const std::scoped_lock lock(mutex_);
+            accepted = available;
+            if (accepted) {
+                text_ = std::move(text);
+            }
+        }
+        if (onWrite) {
+            onWrite();
+        }
+        complete(accepted);
+    }
+
+    std::string storedText() {
+        const std::scoped_lock lock(mutex_);
+        return text_;
+    }
+
+    bool available{true};
+    std::function<void()> onRead;
+    std::function<void()> onWrite;
+
+private:
+    std::mutex mutex_;
+    std::string text_;
+};
+
+class ClipboardBackendTest : public ::testing::Test {
+protected:
+    void SetUp() override {
+        setClipboardBackend(nullptr);
+        setClipboardText("headless");
+    }
+
+    void TearDown() override {
+        setClipboardBackend(nullptr);
+        setClipboardText("");
+    }
+};
+
+TEST_F(ClipboardBackendTest, HeadlessStorageRetainsItsText) {
+    EXPECT_EQ(clipboardText(), "headless");
+    EXPECT_TRUE(setClipboardText(""));
+    EXPECT_EQ(clipboardText(), "");
+}
+
+TEST_F(ClipboardBackendTest, RoutesReadsAndWritesThroughTheInstalledBackend) {
+    const auto backend = std::make_shared<RecordingClipboard>();
+    setClipboardBackend(backend);
+    EXPECT_TRUE(setClipboardText("system text"));
+    EXPECT_EQ(backend->storedText(), "system text");
+    EXPECT_EQ(clipboardText(), "system text");
+    setClipboardBackend(nullptr);
+    EXPECT_EQ(clipboardText(), "headless");
+}
+
+TEST_F(ClipboardBackendTest, FailureCannotReturnOrOverwriteHeadlessData) {
+    const auto backend = std::make_shared<RecordingClipboard>();
+    backend->available = false;
+    setClipboardBackend(backend);
+    EXPECT_FALSE(clipboardText().has_value());
+    EXPECT_FALSE(setClipboardText("lost write"));
+    setClipboardBackend(nullptr);
+    EXPECT_EQ(clipboardText(), "headless");
+}
+
+TEST_F(ClipboardBackendTest, ExpiredBackendDoesNotRevertToHeadlessStorage) {
+    auto backend = std::make_shared<RecordingClipboard>();
+    setClipboardBackend(backend);
+    backend.reset();
+    EXPECT_FALSE(clipboardText().has_value());
+    EXPECT_FALSE(setClipboardText("lost write"));
+    setClipboardBackend(nullptr);
+    EXPECT_EQ(clipboardText(), "headless");
+}
+
+TEST_F(ClipboardBackendTest, MissingWindowCapabilityDoesNotUseHeadlessStorage) {
+    setClipboardUnavailable();
+    EXPECT_FALSE(clipboardText().has_value());
+    EXPECT_FALSE(setClipboardText("lost write"));
+    setClipboardBackend(nullptr);
+    EXPECT_EQ(clipboardText(), "headless");
+}
+
+TEST_F(ClipboardBackendTest, InvokesBackendCallbacksOutsideTheRegistryLock) {
+    const auto backend = std::make_shared<RecordingClipboard>();
+    backend->writeText("backend text", [](bool) {});
+    backend->onRead = [] { setClipboardBackend(nullptr); };
+    setClipboardBackend(backend);
+    EXPECT_EQ(clipboardText(), "backend text");
+    EXPECT_EQ(clipboardText(), "headless");
+    backend->onWrite = [] { setClipboardBackend(nullptr); };
+    setClipboardBackend(backend);
+    EXPECT_TRUE(setClipboardText("new backend text"));
+    EXPECT_EQ(backend->storedText(), "new backend text");
+    EXPECT_EQ(clipboardText(), "headless");
+}
+
+TEST_F(ClipboardBackendTest, ConcurrentCallsRetainTheSelectedBackendForEachOperation) {
+    const auto first = std::make_shared<RecordingClipboard>();
+    const auto second = std::make_shared<RecordingClipboard>();
+    first->writeText("first", [](bool) {});
+    second->writeText("second", [](bool) {});
+    setClipboardBackend(first);
+    std::atomic<bool> valid{true};
+    std::thread reader([&] {
+        for (int count = 0; count < 1000; ++count) {
+            const auto text = clipboardText();
+            if (!text.has_value() || (*text != "first" && *text != "second" && *text != "updated")) {
+                valid = false;
+            }
+        }
+    });
+    std::thread writer([&] {
+        for (int count = 0; count < 1000; ++count) {
+            if (!setClipboardText("updated")) {
+                valid = false;
+            }
+        }
+    });
+    for (int count = 0; count < 1000; ++count) {
+        setClipboardBackend(count % 2 == 0 ? first : second);
+    }
+    reader.join();
+    writer.join();
+    EXPECT_TRUE(valid);
+}
+
+TEST(ClipboardTextTest, AcceptsUnicodeScalarValues) {
+    for (const auto& text : std::vector<std::string>{"", "ascii", std::string(1, '\0'), "雪🙂", "\x7f", "\xc2\x80",
+                                                     "\xdf\xbf", "\xe0\xa0\x80", "\xed\x9f\xbf", "\xee\x80\x80",
+                                                     "\xef\xbf\xbf", "\xf0\x90\x80\x80", "\xf4\x8f\xbf\xbf"}) {
+        EXPECT_TRUE(validClipboardUtf8(text)) << text;
+    }
+}
+
+TEST(ClipboardTextTest, RejectsMalformedOverlongSurrogateAndOutOfRangeSequences) {
+    for (const auto& text : std::vector<std::string>{
+             "\x80", "\xbf", "\xc0\xaf", "\xc1\xbf", "\xc2", "\xc2!", "\xe0\x9f\xbf", "\xe2\x82", "\xe2!\x80",
+             "\xe2\x80!", "\xed\xa0\x80", "\xf0\x8f\xbf\xbf", "\xf4\x90\x80\x80", "\xf5\x80\x80\x80", "\xff"}) {
+        EXPECT_FALSE(validClipboardUtf8(text)) << text;
+    }
+}
+
+} // namespace
+} // namespace react_native_linux
