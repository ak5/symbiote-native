+    controller_->synchronize();
+    recordedEventTypes_->clear();
+    const auto backend = std::make_shared<DelayedClipboard>();
+    react_native_linux::setClipboardBackend(backend);
+    controller_->handleKey(key("v", control));
+    controller_->synchronize();
+    EXPECT_EQ(countRecorded(kChangeEvent), 0U);
+    backend->read(std::string("from peer"));
+    controller_->synchronize();
+    EXPECT_EQ(countRecorded(kChangeEvent), 1U);
+    react_native_linux::setClipboardBackend(nullptr);
+    controller_->handleKey(key("a", control));
