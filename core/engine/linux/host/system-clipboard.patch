+class DelayedClipboard final : public react_native_linux::ClipboardBackend {
+public:
+    void readText(react_native_linux::ClipboardReadCallback complete) override { read = std::move(complete); }
+
+    void writeText(std::string, react_native_linux::ClipboardWriteCallback complete) override {
+        write = std::move(complete);
+    }
+
+    react_native_linux::ClipboardReadCallback read;
+    react_native_linux::ClipboardWriteCallback write;
+};
