+    size_t queuedBytes{0};
+    std::deque<ClipboardReadCallback> deferredReads;
+    std::unordered_map<wl_data_offer*, std::unique_ptr<Offer>> offers;
+    std::unordered_map<wl_data_source*, std::unique_ptr<Source>> sources;
+    wl_data_offer* selection{nullptr};
+    std::vector<Read> reads;
+    std::vector<Write> writes;
+    std::jthread worker;
+    std::string tagPrefix;
+    uint64_t nextSource{0};
+
+    State(wl_display* connection, wl_data_device_manager* dataManager, wl_seat* seat)
+        : display(connection), manager(dataManager, wl_data_device_manager_destroy) {
+        std::random_device random;
+        tagPrefix = "application/x-rnl-clipboard-" + std::to_string(random()) + "-" + std::to_string(random()) + "-";
+        queue.reset(wl_display_create_queue(display));
+        if (queue == nullptr) {
+            throw std::runtime_error("Cannot create the Wayland clipboard event queue");
+        }
+        wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(manager.get()), queue.get());
+        device.reset(wl_data_device_manager_get_data_device(manager.get(), seat));
+        if (device == nullptr) {
+            throw std::runtime_error("Cannot create the Wayland clipboard data device");
+        }
+        static const wl_data_device_listener listener{
+            .data_offer =
+                [](void* data, wl_data_device*, wl_data_offer* proxy) {
+                    auto& state = *static_cast<State*>(data);
+                    auto offer = std::make_unique<Offer>(Offer{&state, {proxy, wl_data_offer_destroy}});
+                    static const wl_data_offer_listener offerListener{
+                        .offer =
+                            [](void* data, wl_data_offer*, const char* mime) {
+                                auto& offer = *static_cast<Offer*>(data);
+                                offer.utf8 |= std::strcmp(mime, kUtf8Mime) == 0;
+                                offer.plain |= std::strcmp(mime, "text/plain") == 0;
+                                offer.utf8String |= std::strcmp(mime, "UTF8_STRING") == 0;
+                                for (const auto& [proxy, source] : offer.owner->sources) {
+                                    if (source->tag == mime) {
+                                        offer.ownTag = source->tag;
+                                        break;
+                                    }
+                                }
+                            },
+                        .source_actions = [](void*, wl_data_offer*, uint32_t) {},
+                        .action = [](void*, wl_data_offer*, uint32_t) {},
+                    };
+                    wl_data_offer_add_listener(proxy, &offerListener, offer.get());
+                    state.offers.emplace(proxy, std::move(offer));
+                },
+            .enter = [](void* data, wl_data_device*, uint32_t, wl_surface*, wl_fixed_t, wl_fixed_t,
+                        wl_data_offer* offer) { static_cast<State*>(data)->offers.erase(offer); },
+            .leave = [](void*, wl_data_device*) {},
+            .motion = [](void*, wl_data_device*, uint32_t, wl_fixed_t, wl_fixed_t) {},
+            .drop = [](void*, wl_data_device*) {},
+            .selection =
+                [](void* data, wl_data_device*, wl_data_offer* offer) {
+                    auto& state = *static_cast<State*>(data);
+                    if (state.selection != offer) {
+                        state.offers.erase(state.selection);
+                    }
+                    state.selection = offer;
+                    const auto found = state.offers.find(offer);
+                    if (found != state.offers.end() && !found->second->ownTag.empty()) {
+                        for (auto& [proxy, source] : state.sources) {
+                            if (source->tag == found->second->ownTag && static_cast<bool>(source->acknowledgement)) {
+                                auto complete = std::move(source->acknowledgement);
+                                complete(true);
+                            }
+                        }
+                    }
+                },
+        };
+        wl_data_device_add_listener(device.get(), &listener, this);
+        int descriptors[2];
+        if (pipe2(descriptors, O_CLOEXEC | O_NONBLOCK) != 0) {
+            throw std::runtime_error("Cannot create the Wayland clipboard wake pipe");
+        }
+        wakeRead.reset(descriptors[0]);
+        wakeWrite.reset(descriptors[1]);
+        worker = std::jthread([this](std::stop_token stop) { run(stop); });
+    }
+
+    void wake() noexcept {
+        const char byte = 0;
+        while (::write(wakeWrite.get(), &byte, 1) < 0 && errno == EINTR) {
+        }
+    }
+
+    void enqueue(Task task) {
+        {
+            const std::scoped_lock lock(mutex);
+            if (accepting && tasks.size() < 256 && task.bytes <= kMaximumTextBytes - queuedBytes) {
+                queuedBytes += task.bytes;
+                tasks.push_back(std::move(task));
+                wake();
+                return;
+            }
+        }
+        task.cancel();
+    }
+
+    void startRead(ClipboardReadCallback complete) {
+        const bool awaitingWrite = std::any_of(sources.begin(), sources.end(), [](const auto& source) {
+            return static_cast<bool>(source.second->acknowledgement);
+        });
+        if (awaitingWrite && deferredReads.size() < 256) {
+            deferredReads.push_back(std::move(complete));
+            return;
+        }
+        if (awaitingWrite || reads.size() >= 4 || (inputState.load() & 1) == 0) {
+            complete(std::nullopt);
+            return;
+        }
+        if (wl_display_dispatch_queue_pending(display, queue.get()) < 0) {
+            throw std::runtime_error("Wayland clipboard dispatch failed");
+        }
+        const auto found = offers.find(selection);
+        if (found == offers.end()) {
+            complete(std::string());
+            return;
+        }
+        const auto& offer = *found->second;
+        const char* mime = offer.utf8         ? kUtf8Mime
+                           : offer.plain      ? "text/plain"
+                           : offer.utf8String ? "UTF8_STRING"
+                                              : nullptr;
+        if (mime == nullptr) {
+            complete(std::string());
+            return;
+        }
+        int descriptors[2];
+        if (pipe2(descriptors, O_CLOEXEC) != 0) {
+            complete(std::nullopt);
+            return;
+        }
+        Descriptor reader(descriptors[0]);
+        Descriptor writer(descriptors[1]);
+        if (!nonblocking(reader.get())) {
+            complete(std::nullopt);
+            return;
+        }
+        reads.push_back(
+            Read{std::move(reader), {}, std::move(complete), std::chrono::steady_clock::now() + kReadTimeout});
+        wl_data_offer_receive(offer.proxy.get(), mime, writer.get());
+    }
+
+    void startWrite(std::string text, ClipboardWriteCallback acknowledgement) {
+        const uint64_t input = inputState.load();
+        if ((input & 3) != 3 || sources.size() >= 4 || text.size() > kMaximumTextBytes || !validClipboardUtf8(text)) {
+            acknowledgement(false);
+            return;
+        }
+        auto source = std::make_unique<Source>(
+            Source{this,
+                   {wl_data_device_manager_create_data_source(manager.get()), wl_data_source_destroy},
+                   std::make_shared<const std::string>(std::move(text)),
+                   tagPrefix + std::to_string(++nextSource),
+                   acknowledgement,
+                   std::chrono::steady_clock::now() + kReadTimeout});
+        if (source->proxy == nullptr) {
+            acknowledgement(false);
+            return;
+        }
+        static const wl_data_source_listener listener{
+            .target = [](void*, wl_data_source*, const char*) {},
+            .send =
+                [](void* data, wl_data_source*, const char* mime, int descriptor) {
+                    auto& source = *static_cast<Source*>(data);
+                    Descriptor output(descriptor);
+                    if ((std::strcmp(mime, kUtf8Mime) == 0 || std::strcmp(mime, "text/plain") == 0 ||
+                         std::strcmp(mime, "UTF8_STRING") == 0) &&
+                        source.owner->writes.size() < 4 && nonblocking(output.get())) {
+                        source.owner->writes.push_back(Write{std::move(output), source.text});
+                    }
+                },
+            .cancelled =
+                [](void* data, wl_data_source* proxy) {
+                    auto& source = *static_cast<Source*>(data);
+                    if (static_cast<bool>(source.acknowledgement)) {
+                        auto complete = std::move(source.acknowledgement);
+                        complete(false);
+                    }
+                    source.owner->sources.erase(proxy);
+                },
+            .dnd_drop_performed = [](void*, wl_data_source*) {},
+            .dnd_finished = [](void*, wl_data_source*) {},
+            .action = [](void*, wl_data_source*, uint32_t) {},
+        };
+        wl_data_source* proxy = source->proxy.get();
+        wl_data_source_add_listener(proxy, &listener, source.get());
+        wl_data_source_offer(proxy, source->tag.c_str());
+        sources.emplace(proxy, std::move(source));
+        wl_data_source_offer(proxy, kUtf8Mime);
+        wl_data_source_offer(proxy, "text/plain");
+        wl_data_source_offer(proxy, "UTF8_STRING");
+        wl_data_device_set_selection(device.get(), proxy, static_cast<uint32_t>(input >> 2));
+    }
+
+    void advanceTransfers() {
+        std::erase_if(reads, [](Read& transfer) {
+            char buffer[8192];
+            while (true) {
+                if (std::chrono::steady_clock::now() >= transfer.deadline) {
+                    transfer.complete(std::nullopt);
+                    return true;
+                }
+                const auto count = ::read(transfer.descriptor.get(), buffer, sizeof(buffer));
+                if (count > 0) {
+                    if (static_cast<size_t>(count) > kMaximumTextBytes - transfer.text.size()) {
+                        transfer.complete(std::nullopt);
+                        return true;
+                    }
+                    transfer.text.append(buffer, static_cast<size_t>(count));
+                } else if (count == 0) {
+                    transfer.complete(validClipboardUtf8(transfer.text) ? std::make_optional(std::move(transfer.text))
+                                                                        : std::nullopt);
+                    return true;
+                } else if (errno != EINTR) {
+                    if ((errno != EAGAIN && errno != EWOULDBLOCK) ||
+                        std::chrono::steady_clock::now() >= transfer.deadline) {
+                        transfer.complete(std::nullopt);
+                        return true;
+                    }
+                    return false;
+                }
+            }
+        });
+        std::erase_if(sources, [](auto& item) {
+            auto& source = item.second;
+            if (source->acknowledgement && std::chrono::steady_clock::now() >= source->deadline) {
+                auto complete = std::move(source->acknowledgement);
+                complete(false);
+                return true;
+            }
+            return false;
+        });
+        if (std::none_of(sources.begin(), sources.end(),
+                         [](const auto& source) { return static_cast<bool>(source.second->acknowledgement); })) {
+            auto pending = std::move(deferredReads);
+            deferredReads.clear();
+            for (auto& complete : pending) {
+                startRead(std::move(complete));
+            }
+        }
+        std::erase_if(writes, [](Write& transfer) {
+            while (transfer.offset < transfer.text->size()) {
+                const auto count = ::write(transfer.descriptor.get(), transfer.text->data() + transfer.offset,
+                                           transfer.text->size() - transfer.offset);
+                if (count > 0) {
+                    transfer.offset += static_cast<size_t>(count);
+                } else if (count == 0 || (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK)) {
+                    return true;
+                } else if (errno != EINTR) {
+                    return false;
+                }
+            }
+            return true;
+        });
+    }
+
+    void run(std::stop_token stop) noexcept {
+        sigset_t signals;
+        sigemptyset(&signals);
+        sigaddset(&signals, SIGPIPE);
+        try {
+            if (pthread_sigmask(SIG_BLOCK, &signals, nullptr) != 0) {
+                throw std::runtime_error("Cannot protect clipboard transfers from SIGPIPE");
+            }
+            while (!stop.stop_requested()) {
+                if (wl_display_dispatch_queue_pending(display, queue.get()) < 0) {
+                    throw std::runtime_error("Wayland clipboard dispatch failed");
+                }
+                std::deque<Task> pending;
+                {
+                    const std::scoped_lock lock(mutex);
+                    pending.swap(tasks);
+                    queuedBytes = 0;
+                }
+                for (auto& task : pending) {
+                    try {
+                        task.run();
+                    } catch (...) {
+                        task.cancel();
+                        throw;
+                    }
+                }
+                pending.clear();
+                advanceTransfers();
+                std::vector<pollfd> descriptors{{wl_display_get_fd(display), POLLIN, 0}, {wakeRead.get(), POLLIN, 0}};
+                int timeout = -1;
+                for (const auto& transfer : reads) {
+                    descriptors.push_back({transfer.descriptor.get(), POLLIN, 0});
+                    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                               transfer.deadline - std::chrono::steady_clock::now())
+                                               .count();
+                    const int milliseconds = static_cast<int>(std::clamp<int64_t>(remaining, 0, 2000));
+                    timeout = timeout < 0 ? milliseconds : std::min(timeout, milliseconds);
+                }
+                for (const auto& transfer : writes) {
+                    descriptors.push_back({transfer.descriptor.get(), POLLOUT, 0});
+                }
+                for (const auto& [proxy, source] : sources) {
+                    if (static_cast<bool>(source->acknowledgement)) {
+                        const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                   source->deadline - std::chrono::steady_clock::now())
+                                                   .count();
+                        const int milliseconds = static_cast<int>(std::clamp<int64_t>(remaining, 0, 2000));
+                        timeout = timeout < 0 ? milliseconds : std::min(timeout, milliseconds);
+                    }
+                }
+                if (wl_display_prepare_read_queue(display, queue.get()) != 0) {
+                    if (errno == EAGAIN) {
+                        continue;
+                    }
+                    throw std::runtime_error("Cannot prepare the Wayland clipboard connection");
+                }
+                const int flushed = wl_display_flush(display);
+                if (flushed < 0 && errno != EAGAIN) {
+                    wl_display_cancel_read(display);
+                    throw std::runtime_error("Cannot flush the Wayland clipboard connection");
+                }
+                if (flushed < 0) {
+                    descriptors[0].events |= POLLOUT;
+                }
+                const int polled = poll(descriptors.data(), descriptors.size(), timeout);
+                const int pollError = errno;
+                if (polled > 0 && (descriptors[0].revents & POLLIN) != 0) {
+                    if (wl_display_read_events(display) < 0) {
+                        throw std::runtime_error("Cannot read the Wayland clipboard connection");
+                    }
+                } else {
+                    wl_display_cancel_read(display);
+                }
+                if (polled < 0 && pollError != EINTR) {
+                    throw std::runtime_error("Clipboard poll failed");
+                }
+                if ((descriptors[0].revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
+                    throw std::runtime_error("Wayland clipboard disconnected");
+                }
+                char buffer[64];
+                while (::read(wakeRead.get(), buffer, sizeof(buffer)) > 0) {
+                }
+            }
+        } catch (const std::exception& error) {
+            std::cerr << "[rnl-clipboard] transfer worker stopped: " << error.what() << std::endl;
+        }
+        std::deque<Task> pending;
+        {
+            const std::scoped_lock lock(mutex);
+            accepting = false;
+            pending.swap(tasks);
+        }
+        for (auto& task : pending) {
+            task.cancel();
+        }
+        for (auto& transfer : reads) {
+            transfer.complete(std::nullopt);
+        }
+        for (auto& complete : deferredReads) {
+            complete(std::nullopt);
+        }
+        deferredReads.clear();
+        reads.clear();
+        writes.clear();
+        for (auto& [proxy, source] : sources) {
+            if (static_cast<bool>(source->acknowledgement)) {
+                source->acknowledgement(false);
+            }
+        }
+        sources.clear();
+        offers.clear();
+        device.reset();
+        manager.reset();
+        queue.reset();
+    }
+};
+
+WaylandClipboard::WaylandClipboard(wl_display* display, wl_data_device_manager* manager, wl_seat* seat)
+    : state_(std::make_unique<State>(display, manager, seat)) {}
+
+WaylandClipboard::~WaylandClipboard() { stop(); }
+
+void WaylandClipboard::readText(ClipboardReadCallback complete) {
+    state_->enqueue(
+        {[state = state_.get(), complete] { state->startRead(complete); }, [complete] { complete(std::nullopt); }});
+}
+
+void WaylandClipboard::writeText(std::string text, ClipboardWriteCallback complete) {
+    const size_t bytes = text.size();
+    state_->enqueue({[state = state_.get(), complete, text = std::move(text)]() mutable {
+                         state->startWrite(std::move(text), complete);
+                     },
+                     [complete] { complete(false); }, bytes});
+}
+
+void WaylandClipboard::setFocus(bool focused) noexcept {
+    if (focused) {
+        state_->inputState.fetch_or(1);
+    } else {
+        state_->inputState.fetch_and(~uint64_t{1});
+    }
+    state_->wake();
+}
+
+void WaylandClipboard::setSelectionSerial(uint32_t serial) noexcept {
+    uint64_t previous = state_->inputState.load();
+    while (!state_->inputState.compare_exchange_weak(previous, (uint64_t{serial} << 2) | 2 | (previous & 1))) {
+    }
+}
+
+void WaylandClipboard::stop() noexcept {
+    if (state_->worker.joinable()) {
+        state_->worker.request_stop();
+        state_->wake();
+        state_->worker.join();
+    }
+}
+
+} // namespace react_native_linux
