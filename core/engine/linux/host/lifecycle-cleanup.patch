diff --git a/packages/core/cmake/accesskit-owned-actions.patch b/packages/core/cmake/accesskit-owned-actions.patch
new file mode 100644
--- /dev/null
+++ b/packages/core/cmake/accesskit-owned-actions.patch
@@ -0,0 +1,94 @@
+diff --git a/src/common.rs b/src/common.rs
+--- a/src/common.rs
++++ b/src/common.rs
+@@ -1114,6 +1114,16 @@
+     pub data: opt_action_data,
+ }
+ 
++impl Drop for action_request {
++    fn drop(&mut self) {
++        if self.data.has_value {
++            // MaybeUninit does not drop the owned action payload automatically.
++            unsafe { self.data.value.assume_init_drop() };
++            self.data.has_value = false;
++        }
++    }
++}
++
+ impl From<ActionRequest> for action_request {
+     fn from(request: ActionRequest) -> action_request {
+         Self {
+@@ -1232,3 +1242,73 @@
+ /// This function can't return a null pointer. Ownership of the returned value will be transferred to the caller.
+ pub type tree_update_factory =
+     Option<extern "C" fn(tree_update_factory_userdata) -> *mut tree_update>;
++
++#[cfg(test)]
++mod action_request_tests {
++    use super::*;
++    use std::alloc::{GlobalAlloc, Layout, System};
++    use std::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
++
++    struct TrackingAllocator;
++    static WATCHED: AtomicPtr<u8> = AtomicPtr::new(ptr::null_mut());
++    static FREED: AtomicBool = AtomicBool::new(false);
++
++    #[global_allocator]
++    static ALLOCATOR: TrackingAllocator = TrackingAllocator;
++
++    unsafe impl GlobalAlloc for TrackingAllocator {
++        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
++            unsafe { System.alloc(layout) }
++        }
++
++        unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
++            if pointer == WATCHED.load(Ordering::SeqCst) {
++                FREED.store(true, Ordering::SeqCst);
++            }
++            unsafe { System.dealloc(pointer, layout) }
++        }
++    }
++
++    #[test]
++    fn request_free_releases_the_owned_text_payload() {
++        let request: action_request = ActionRequest {
++            action: Action::SetValue,
++            target_tree: TreeId::ROOT,
++            target_node: NodeId(1),
++            data: Some(ActionData::Value("café 雪 🐧".into())),
++        }
++        .into();
++        assert!(request.data.has_value);
++        let pointer = match unsafe { request.data.value.assume_init_ref() } {
++            action_data::Value(pointer) => *pointer,
++            _ => panic!("Expected the actual owned C string"),
++        };
++        WATCHED.store(pointer.cast(), Ordering::SeqCst);
++        FREED.store(false, Ordering::SeqCst);
++        accesskit_action_request_free(Box::into_raw(Box::new(request)));
++        let freed = FREED.load(Ordering::SeqCst);
++        WATCHED.store(ptr::null_mut(), Ordering::SeqCst);
++        if !freed {
++            accesskit_string_free(pointer);
++        }
++        assert!(freed, "request_free leaked the owned text payload");
++    }
++
++    #[test]
++    fn request_free_handles_absent_and_non_text_payloads() {
++        for data in [
++            None,
++            Some(ActionData::NumericValue(42.0)),
++            Some(ActionData::CustomAction(7)),
++        ] {
++            let request: action_request = ActionRequest {
++                action: Action::SetValue,
++                target_tree: TreeId::ROOT,
++                target_node: NodeId(1),
++                data,
++            }
++            .into();
++            accesskit_action_request_free(Box::into_raw(Box::new(request)));
++        }
++    }
++}
